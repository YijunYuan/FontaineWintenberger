module

public import FontaineWintenberger.LocalField.Hensel.NewtonValuation
public import FontaineWintenberger.Mathlib.Analysis.Krasner
public import FontaineWintenberger.Mathlib.RingTheory.PolynomialDiscriminant

/-!
# Exact separable roots from approximate roots

The integral discriminant identity supplies the nonunit derivative bound.
Newton lifting constructs a root in the original finite extension; root
separation and Krasner descent place it in the field generated by the
approximation and prove uniqueness.
-/

@[expose] public section

noncomputable section

namespace FontaineWintenberger

open Polynomial IntermediateField

section UnitBall

variable {K : Type*} [NontriviallyNormedField K] [IsUltrametricDist K]

local notation "O" => Valuation.valuationSubring (NormedField.valuation (K := K))

/-- The actual discriminant separates any two original integral roots. -/
theorem unitBall_root_eq_of_norm_sub_lt_discr (f : Polynomial O) (hf : f.Monic)
    {a b z : O} (ha : f.eval a = 0) (hb : f.eval b = 0)
    (haz : ‖a - z‖ < ‖f.discr‖) (hbz : ‖b - z‖ < ‖f.discr‖) : a = b := by
  by_contra hab
  have ha' : aeval (a : K) f = 0 := by
    change aeval (algebraMap O K a) f = 0
    rw [aeval_algebraMap_apply_eq_algebraMap_eval, ha, map_zero]
  have hb' : aeval (b : K) f = 0 := by
    change aeval (algebraMap O K b) f = 0
    rw [aeval_algebraMap_apply_eq_algebraMap_eval, hb, map_zero]
  have hab' : (a : K) ≠ (b : K) := fun h => hab (Subtype.ext h)
  have hpair : ‖f.discr‖ ≤ ‖a - b‖ ^ 2 := by
    exact_mod_cast valuation_discr_le_sub_sq (NormedField.valuation (K := K))
      f hf (a : K) (b : K) ha' hb' hab'
  have hdiff_le : ‖a - b‖ ≤ 1 := by exact_mod_cast (a - b).property
  have hdiff : ‖a - b‖ < ‖f.discr‖ := by
    calc
      ‖a - b‖ = ‖a - z + (z - b)‖ := by rw [sub_add_sub_cancel]
      _ ≤ max ‖a - z‖ ‖z - b‖ := IsUltrametricDist.norm_add_le_max _ _
      _ < ‖f.discr‖ := max_lt haz (by rwa [norm_sub_rev])
  nlinarith [norm_nonneg (a - b)]

variable [CompleteSpace K]

/-- The integral Bezout identity supplies Newton's hypothesis and the root
lies within the original discriminant radius. -/
theorem unitBall_hensel_of_discr (f : Polynomial O) (hf : f.Monic)
    (hdegree : 0 < f.natDegree) (z : O) (hz : ‖f.eval z‖ < ‖f.discr‖ ^ 2) :
    ∃ a : O, f.eval a = 0 ∧ ‖a - z‖ < ‖f.discr‖ ∧
      ∀ b : O, f.eval b = 0 → ‖b - z‖ < ‖f.discr‖ → b = a := by
  have hdiscr_nonneg := norm_nonneg f.discr
  have hdiscr_le : ‖f.discr‖ ≤ 1 := by exact_mod_cast f.discr.property
  have hresidual : ‖f.eval z‖ < ‖f.discr‖ := hz.trans_le (by nlinarith)
  have hderiv : ‖f.discr‖ ≤ ‖f.derivative.eval z‖ := by
    have hv : (NormedField.valuation (K := K)) (↑(f.eval z) : K) <
        (NormedField.valuation (K := K)) (f.discr : K) := by exact_mod_cast hresidual
    exact_mod_cast valuation_discr_le_derivative (NormedField.valuation (K := K))
      f hf hdegree z hv
  have hnewton : ‖f.eval z‖ < ‖f.derivative.eval z‖ ^ 2 := by
    nlinarith [norm_nonneg (f.derivative.eval z)]
  obtain ⟨a, ha, _, _, hdist, _⟩ := unitBall_hensel_nonunit hnewton
  have hderiv_pos : 0 < ‖f.derivative.eval z‖ := by
    nlinarith [norm_nonneg (f.eval z), norm_nonneg (f.derivative.eval z)]
  have hclose : ‖a - z‖ < ‖f.discr‖ := by
    rw [hdist, div_lt_iff₀ hderiv_pos]
    nlinarith
  exact ⟨a, ha, hclose, fun b hb hbz =>
    unitBall_root_eq_of_norm_sub_lt_discr f hf hb ha hbz hclose⟩

end UnitBall

section NormedExtension

variable {K L : Type*} [NontriviallyNormedField K] [IsUltrametricDist K] [CompleteSpace K]
    [NontriviallyNormedField L] [NormedAlgebra K L] [FiniteDimensional K L]

local notation "OK" => Valuation.valuationSubring (NormedField.valuation (K := K))

omit [CompleteSpace K] [FiniteDimensional K L] in
private theorem normedAlgebra_valuation_hasExtension [IsUltrametricDist L] :
    (NormedField.valuation (K := K)).HasExtension (NormedField.valuation (K := L)) where
  val_isEquiv_comap := by
    intro x y
    change ‖x‖₊ ≤ ‖y‖₊ ↔ ‖algebraMap K L x‖₊ ≤ ‖algebraMap K L y‖₊
    exact_mod_cast (show ‖x‖ ≤ ‖y‖ ↔ ‖algebraMap K L x‖ ≤ ‖algebraMap K L y‖ by
      rw [norm_algebraMap', norm_algebraMap'])

/-- The actual finite extension is complete. Its integral discriminant
identity and Newton sequence produce the unique nearby original root. -/
theorem exists_root_near_of_discr (f : Polynomial OK) (hf : f.Monic)
    (hdegree : 0 < f.natDegree) (z : L) (hz : ‖z‖ ≤ 1)
    (happrox : ‖aeval z f‖ < ‖f.discr‖ ^ 2) :
    ∃ a : L, aeval a f = 0 ∧ ‖a - z‖ < ‖f.discr‖ ∧
      ∀ b : L, aeval b f = 0 → ‖b - z‖ < ‖f.discr‖ → b = a := by
  let : IsUltrametricDist L := IsUltrametricDist.of_normedAlgebra K
  let : CompleteSpace L := FiniteDimensional.complete K L
  let : (NormedField.valuation (K := K)).HasExtension (NormedField.valuation (K := L)) :=
    normedAlgebra_valuation_hasExtension
  let OL := (NormedField.valuation (K := L)).valuationSubring
  let φ : OK →+* OL := algebraMap OK OL
  let g := f.map φ
  let z₀ : OL := ⟨z, by exact_mod_cast hz⟩
  have hcomm : (algebraMap OL L).comp φ = algebraMap OK L := by ext x; rfl
  have heval (x : OL) : (↑(g.eval x) : L) = aeval (x : L) f := by
    change algebraMap OL L (g.eval x) = _
    rw [← aeval_algebraMap_apply_eq_algebraMap_eval, ← aeval_eq_aeval_map hcomm]
    rfl
  have hdiscr : (↑g.discr : L) = algebraMap K L (f.discr : K) := by
    rw [monic_discr_map f hf φ]
    rfl
  have hdiscrnorm : ‖g.discr‖ = ‖f.discr‖ := by
    change ‖(↑g.discr : L)‖ = ‖(f.discr : K)‖
    rw [hdiscr, norm_algebraMap']
  have hgdegree : 0 < g.natDegree := by rwa [hf.natDegree_map φ]
  have hz₀ : ‖g.eval z₀‖ < ‖g.discr‖ ^ 2 := by
    change ‖(↑(g.eval z₀) : L)‖ < ‖g.discr‖ ^ 2
    rw [heval, hdiscrnorm]
    exact happrox
  obtain ⟨a₀, ha₀, hclose₀, huniq₀⟩ := unitBall_hensel_of_discr g (hf.map φ) hgdegree z₀ hz₀
  have ha : aeval (a₀ : L) f = 0 := by rw [← heval, ha₀]; rfl
  have hclose : ‖(a₀ : L) - z‖ < ‖f.discr‖ := by
    rw [← hdiscrnorm]
    exact hclose₀
  refine ⟨a₀, ha, hclose, ?_⟩
  intro b hb hbz
  have hb' : aeval b g = 0 := by rw [← aeval_eq_aeval_map hcomm]; exact hb
  let b₀ : OL := ⟨b, monic_root_valuation_le_one (NormedField.valuation (K := L))
    g (hf.map φ) b hb'⟩
  have hb₀ : g.eval b₀ = 0 := by
    apply Subtype.ext
    change (↑(g.eval b₀) : L) = 0
    rw [heval]
    exact hb
  have hdist₀ : ‖b₀ - z₀‖ < ‖g.discr‖ := by
    rw [hdiscrnorm]
    exact hbz
  exact congrArg (fun x : OL => (x : L)) (huniq₀ b₀ hb₀ hdist₀)

variable [Algebra.IsSeparable K L]

/-- An approximate root in the original finite separable extension yields
an actual root in the original simple field generated by that approximation.
The root is unique among all roots within the discriminant radius. -/
theorem exists_root_mem_adjoin_of_discr (f : Polynomial OK) (hf : f.Monic)
    (hdegree : 0 < f.natDegree) (z : L) (hz : ‖z‖ ≤ 1)
    (happrox : ‖aeval z f‖ < ‖f.discr‖ ^ 2) :
    ∃ a : L, aeval a f = 0 ∧ a ∈ K⟮z⟯ ∧ ‖a - z‖ < ‖f.discr‖ ∧
      ∀ b : L, aeval b f = 0 → ‖b - z‖ < ‖f.discr‖ → b = a := by
  obtain ⟨a, ha, hclose, huniq⟩ := exists_root_near_of_discr f hf hdegree z hz happrox
  let Ω := SeparableClosure K
  let : NontriviallyNormedField Ω := spectralNorm.nontriviallyNormedField K Ω
  let : NormedAlgebra K Ω := spectralNorm.normedAlgebra K Ω
  let : IsUltrametricDist Ω := IsUltrametricDist.of_normedAlgebra K
  let : (NormedField.valuation (K := K)).HasExtension (NormedField.valuation (K := Ω)) :=
    normedAlgebra_valuation_hasExtension
  let i : L →ₐ[K] Ω := IsSepClosed.lift
  algebraize [i.toRingHom]
  let : NormedAlgebra L Ω := spectralNorm.normedAlgebra' K L Ω
  have norm_i (x : L) : ‖i x‖ = ‖x‖ := norm_algebraMap' Ω x
  have hrooti : aeval (i a) f = 0 := by
    change aeval ((i.restrictScalars OK) a) f = 0
    rw [aeval_algHom (i.restrictScalars OK) a, AlgHom.comp_apply, ha, map_zero]
  let fK := f.map (algebraMap OK K)
  have hcoeffK : (algebraMap K Ω).comp (algebraMap OK K) = algebraMap OK Ω := by
    ext x
    rfl
  have hrootiK : aeval (i a) fK = 0 := by
    rw [← aeval_eq_aeval_map hcoeffK]
    exact hrooti
  have hmin : minpoly K (i a) ∣ fK := minpoly.dvd K (i a) hrootiK
  have hdiscr_le : ‖f.discr‖ ≤ 1 := by exact_mod_cast f.discr.property
  have hseparation (c : Ω) (hc : IsConjRoot K (i a) c) (hne : i a ≠ c) :
      ‖f.discr‖ ≤ ‖i a - c‖ := by
    have hcfK : aeval c fK = 0 :=
      aeval_eq_zero_of_dvd_aeval_eq_zero hmin hc.aeval_eq_zero
    have hcf : aeval c f = 0 := by
      rw [aeval_eq_aeval_map hcoeffK]
      exact hcfK
    have hp : ‖algebraMap K Ω (f.discr : K)‖ ≤ ‖i a - c‖ ^ 2 := by
      exact_mod_cast valuation_discr_le_sub_sq_of_extension
        (NormedField.valuation (K := Ω)) (NormedField.valuation (K := K))
        f hf (i a) c hrooti hcf hne
    rw [norm_algebraMap'] at hp
    change ‖f.discr‖ ≤ ‖i a - c‖ ^ 2 at hp
    by_cases hlarge : 1 ≤ ‖i a - c‖
    · exact hdiscr_le.trans hlarge
    · have hsmall : ‖i a - c‖ ≤ 1 := (lt_of_not_ge hlarge).le
      nlinarith [norm_nonneg (i a - c)]
  have hclosei : ‖i a - i z‖ < ‖f.discr‖ := by
    rw [← map_sub, norm_i]
    exact hclose
  have hmemi : i a ∈ K⟮i z⟯ := krasner_mem_adjoin
    (fun c hc hne => hclosei.trans_le (hseparation c hc hne))
  have hmem : a ∈ K⟮z⟯ := by
    simpa [← Set.image_singleton, ← IntermediateField.adjoin_map] using! hmemi
  exact ⟨a, ha, hmem, hclose, huniq⟩

end NormedExtension

section OriginalValuation

variable (K : Type*) [Field K] (ΓK : Type*) [LinearOrderedCommGroupWithZero ΓK]
    [val : Valued K ΓK] [Valuation.IsRankOneDiscrete val.v] [CompleteSpace K]
    [IsDiscreteValuationRing val.v.valuationSubring]
    (L : Type*) [Field L] [Algebra K L] [FiniteDimensional K L] [Algebra.IsSeparable K L]
    {ΓL : Type*} [LinearOrderedCommGroupWithZero ΓL] (w : Valuation L ΓL)
    [val.v.HasExtension w]

/-- Exact root extraction for the supplied valuation of the supplied finite
separable extension. The original valuation ring and its original discriminant
are retained, and containment is proved by the preceding Krasner construction. -/
theorem discreteValued_exists_root_mem_adjoin_of_discr
    (f : Polynomial val.v.valuationSubring) (hf : f.Monic) (hdegree : 0 < f.natDegree)
    (z : L) (hz : w z ≤ 1)
    (happrox : w (aeval z f) < w (algebraMap K L (f.discr : K)) ^ 2) :
    ∃ a : L, aeval a f = 0 ∧ a ∈ K⟮z⟯ ∧
      w (a - z) < w (algebraMap K L (f.discr : K)) ∧
      ∀ b : L, aeval b f = 0 →
        w (b - z) < w (algebraMap K L (f.discr : K)) → b = a := by
  let : Valuation.RankOne val.v :=
    Valuation.IsRankOneDiscrete.rankOne val.v (e := 2) (by norm_num)
  let : NontriviallyNormedField K := discreteValuedNormedField K ΓK
  let : IsUltrametricDist K :=
    IsUltrametricDist.isUltrametricDist_iff_isNonarchimedean_norm.mpr
      (Valued.isNonarchimedean_norm K ΓK)
  let : IsCompleteDiscreteValuedField K := discreteValued_isCompleteDiscreteValuedField K ΓK
  let : (NormedField.valuation (K := K)).HasExtension w :=
    discreteValued_norm_hasExtension K ΓK L w
  let : NontriviallyNormedField L := spectralNorm.nontriviallyNormedField K L
  let : NormedAlgebra K L := spectralNorm.normedAlgebra K L
  let : IsUltrametricDist L := IsUltrametricDist.of_normedAlgebra K
  have hringL : (NormedField.valuation (K := L)).valuationSubring = w.valuationSubring :=
    spectralIntegerRing_eq_extension_valuationSubring K L w
  have hval : (NormedField.valuation (K := L)).IsEquiv w :=
    (Valuation.isEquiv_iff_valuationSubring _ _).mpr hringL
  have hle (x y : L) : ‖x‖ ≤ ‖y‖ ↔ w x ≤ w y := by exact_mod_cast hval x y
  have hlt (x y : L) : ‖x‖ < ‖y‖ ↔ w x < w y := by
    simp only [lt_iff_not_ge, hle]
  have hznorm : ‖z‖ ≤ 1 := by
    have h := (hle z 1).mpr (by simpa only [map_one] using hz)
    simpa only [norm_one] using h
  have hringK := discreteValued_valuationSubring K ΓK
  revert happrox hdegree hf f
  rw [← hringK]
  intro f hf hdegree happrox
  have happroxnorm : ‖aeval z f‖ < ‖f.discr‖ ^ 2 := by
    have h : ‖aeval z f‖ < ‖algebraMap K L (f.discr : K) ^ 2‖ :=
      (hlt _ _).mpr (by simpa only [map_pow] using happrox)
    rw [norm_pow, norm_algebraMap'] at h
    change ‖aeval z f‖ < ‖(f.discr : K)‖ ^ 2
    exact h
  obtain ⟨a, ha, hmem, hclose, huniq⟩ :=
    exists_root_mem_adjoin_of_discr f hf hdegree z hznorm happroxnorm
  refine ⟨a, ha, hmem, ?_, ?_⟩
  · apply (hlt _ _).mp
    rw [norm_algebraMap']
    exact hclose
  · intro b hb hbz
    apply huniq b hb
    have h := (hlt _ _).mpr hbz
    rw [norm_algebraMap'] at h
    exact h

/-- Associated additive-valuation form with the original extension
valuation: residual value greater than twice the discriminant value yields
the unique root at distance value greater than that discriminant value. -/
theorem discreteValued_exists_root_mem_adjoin_of_discr_additive
    (f : Polynomial val.v.valuationSubring) (hf : f.Monic) (hdegree : 0 < f.natDegree)
    (z : L) (hz : w z ≤ 1)
    (happrox : (2 : ℕ) • (Valuation.toAddValuation w) (algebraMap K L (f.discr : K)) <
      (Valuation.toAddValuation w) (aeval z f)) :
    ∃ a : L, aeval a f = 0 ∧ a ∈ K⟮z⟯ ∧
      (Valuation.toAddValuation w) (algebraMap K L (f.discr : K)) <
        (Valuation.toAddValuation w) (a - z) ∧
      ∀ b : L, aeval b f = 0 →
        (Valuation.toAddValuation w) (algebraMap K L (f.discr : K)) <
          (Valuation.toAddValuation w) (b - z) → b = a := by
  have hmul : w (aeval z f) < w (algebraMap K L (f.discr : K)) ^ 2 := by
    rw [two_nsmul] at happrox
    change w (aeval z f) <
      w (algebraMap K L (f.discr : K)) * w (algebraMap K L (f.discr : K)) at happrox
    simpa only [pow_two] using happrox
  exact discreteValued_exists_root_mem_adjoin_of_discr K ΓK L w f hf hdegree z hz hmul

end OriginalValuation

end FontaineWintenberger

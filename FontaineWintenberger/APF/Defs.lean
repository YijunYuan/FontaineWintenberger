public import Mathlib.FieldTheory.Galois.Infinite
public import Mathlib.Topology.Algebra.OpenSubgroup

/-!
# Arithmetically profinite extensions

## APF openness for arbitrary separable intermediate fields

The fixing subgroup of the extension need not be normal. Normality of the
absolute upper groups identifies the subgroup supremum with the
product. Compactness makes its finite-index condition equivalent
to openness, including finite and trivial extensions.

## APF for abstract separable extensions

Embeddings into the separable closure exist and are conjugate under its
Galois group. Normality of the absolute upper groups makes APF independent of
the embedding. The public predicate therefore applies to arbitrary separable
field extensions, with no normality or finiteness assumption.

## Main definitions

* `apfSubgroup`: The subgroup generated by an arbitrary fixing subgroup and an absolute upper group.
* `IsAPFSubextension`: Arithmetic profiniteness for an arbitrary separable extension inside the
  fixed separable closure: `G_K^u · G_L` is open in `G_K` for every `u ≥ -1` (Wintenberger 1.2.1).
* `IsAPF`: Arithmetic profiniteness of an abstract separable field extension `L/K` (Wintenberger
  1.2.1): the image of every `K`-embedding `L → K^sep` is an APF subextension.

## Main results

* `IsAPFSubextension.of_le`: APF descends to every intermediate subextension, including nonnormal
  ones.
* `apfSubgroup_map`: Conjugation carries the APF subgroup onto that of the conjugate field.
* `nonempty_separableClosure_embeddings`: Every abstract separable extension has a separable-closure
  embedding.
* `exists_aut_comp_separableClosure_embeddings`: Two separable-closure embeddings are conjugate by
  an automorphism.
* `isAPF_iff_embedding`: The public APF predicate can be tested using any specified embedding.
* `isAPF_iff_exists_embedding`: The embedding quantifier in `IsAPF` is nonvacuous.
* `IsAPF.of_algHom`: APF descends along every algebra embedding, including nonnormal subextensions
  (Wintenberger 1.2.3 (iii)).

## References

* Wintenberger, *Le corps des normes de certaines extensions infinies de corps locaux;
  applications*, §1 (extensions arithmétiquement profinies).
-/

@[expose] public section

namespace FontaineWintenberger

open scoped Pointwise

variable (K : Type*) [NontriviallyNormedField K] [IsCompleteDiscreteValuedField K]

/-- The subgroup generated by an arbitrary fixing subgroup and an absolute upper group. -/
noncomputable def apfSubgroup (L : IntermediateField K (SeparableClosure K)) (u : ℝ) :
    Subgroup (SeparableClosure K ≃ₐ[K] SeparableClosure K) :=
  L.fixingSubgroup ⊔ absoluteUpperRamificationGroup K u

/-- Arithmetic profiniteness for an arbitrary separable extension inside the fixed separable
closure: `G_K^u · G_L` is open in `G_K` for every `u ≥ -1` (Wintenberger 1.2.1). -/
class IsAPFSubextension (L : IntermediateField K (SeparableClosure K)) : Prop where
  isOpen_apfSubgroup : ∀ u : ℝ, -1 ≤ u →
    IsOpen (apfSubgroup K L u : Set (SeparableClosure K ≃ₐ[K] SeparableClosure K))

theorem isAPFSubextension_iff (L : IntermediateField K (SeparableClosure K)) :
    IsAPFSubextension K L ↔ ∀ u : ℝ, -1 ≤ u →
      IsOpen (apfSubgroup K L u : Set (SeparableClosure K ≃ₐ[K] SeparableClosure K)) :=
  ⟨fun h => h.isOpen_apfSubgroup, fun h => ⟨h⟩⟩

theorem coe_apfSubgroup (L : IntermediateField K (SeparableClosure K)) (u : ℝ) :
    (apfSubgroup K L u : Set (SeparableClosure K ≃ₐ[K] SeparableClosure K)) =
      (L.fixingSubgroup : Set _) * (absoluteUpperRamificationGroup K u : Set _) :=
  Subgroup.mul_normal _ _

theorem coe_apfSubgroup_upper_mul (L : IntermediateField K (SeparableClosure K)) (u : ℝ) :
    (apfSubgroup K L u : Set (SeparableClosure K ≃ₐ[K] SeparableClosure K)) =
      (absoluteUpperRamificationGroup K u : Set _) * (L.fixingSubgroup : Set _) := by
  rw [apfSubgroup, sup_comm]
  exact Subgroup.normal_mul _ _

theorem isCompact_apfSubgroup (L : IntermediateField K (SeparableClosure K)) (u : ℝ) :
    IsCompact (apfSubgroup K L u : Set (SeparableClosure K ≃ₐ[K] SeparableClosure K)) := by
  rw [coe_apfSubgroup]
  exact (InfiniteGalois.fixingSubgroup_isClosed L).isCompact.mul
    (isCompact_upperRamificationGroupInfinite K (SeparableClosure K) u)

theorem isClosed_apfSubgroup (L : IntermediateField K (SeparableClosure K)) (u : ℝ) :
    IsClosed (apfSubgroup K L u : Set (SeparableClosure K ≃ₐ[K] SeparableClosure K)) := by
  let : T2Space (SeparableClosure K ≃ₐ[K] SeparableClosure K) :=
    krullTopology_t2
  exact (isCompact_apfSubgroup K L u).isClosed

theorem isOpen_apfSubgroup_iff_finiteIndex
    (L : IntermediateField K (SeparableClosure K)) (u : ℝ) :
    IsOpen (apfSubgroup K L u : Set (SeparableClosure K ≃ₐ[K] SeparableClosure K)) ↔
      (apfSubgroup K L u).FiniteIndex := by
  constructor
  · intro h
    let := (apfSubgroup K L u).quotient_finite_of_isOpen h
    exact Subgroup.finiteIndex_of_finite_quotient
  · intro h
    let := h
    exact (apfSubgroup K L u).isOpen_of_isClosed_of_finiteIndex (isClosed_apfSubgroup K L u)

theorem isAPFSubextension_iff_finiteIndex (L : IntermediateField K (SeparableClosure K)) :
    IsAPFSubextension K L ↔ ∀ u : ℝ, -1 ≤ u → (apfSubgroup K L u).FiniteIndex := by
  simp only [isAPFSubextension_iff, isOpen_apfSubgroup_iff_finiteIndex]

theorem IsAPFSubextension.index_pos {L : IntermediateField K (SeparableClosure K)}
    [hL : IsAPFSubextension K L]
    (u : ℝ) (hu : -1 ≤ u) : 0 < (apfSubgroup K L u).index := by
  exact Nat.pos_of_ne_zero (Subgroup.finiteIndex_iff.mp
    ((isAPFSubextension_iff_finiteIndex K L).mp ‹_› u hu))

/-- Every finite separable subextension is APF, without a Galois hypothesis. -/
instance isAPFSubextension_of_finite (L : IntermediateField K (SeparableClosure K))
    [FiniteDimensional K L] :
    IsAPFSubextension K L := by
  refine ⟨fun u _ => ?_⟩
  exact Subgroup.isOpen_mono (show L.fixingSubgroup ≤ apfSubgroup K L u from le_sup_left)
    (IntermediateField.fixingSubgroup_isOpen L)

/-- APF descends to every intermediate subextension, including nonnormal ones. -/
theorem IsAPFSubextension.of_le {M L : IntermediateField K (SeparableClosure K)}
    [hL : IsAPFSubextension K L] (hML : M ≤ L) : IsAPFSubextension K M := by
  refine ⟨fun u hu => ?_⟩
  exact Subgroup.isOpen_mono
    (sup_le_sup_right (IntermediateField.fixingSubgroup_le hML) _) (hL.isOpen_apfSubgroup u hu)

theorem apfSubgroup_antitoneOn (L : IntermediateField K (SeparableClosure K)) :
    AntitoneOn (apfSubgroup K L) (Set.Ici (-1)) := by
  intro u hu v hv huv
  exact sup_le_sup_left (upperRamificationGroupInfinite_antitoneOn K (SeparableClosure K)
    hu hv huv) _

@[simp]
theorem apfSubgroup_neg_one (L : IntermediateField K (SeparableClosure K)) :
    apfSubgroup K L (-1) = ⊤ := by
  simp [apfSubgroup, absoluteUpperRamificationGroup]

end FontaineWintenberger

namespace FontaineWintenberger

open scoped Pointwise

variable (K : Type*) [NontriviallyNormedField K] [IsCompleteDiscreteValuedField K]

/-- Conjugation carries the APF subgroup onto that of the conjugate field. -/
theorem apfSubgroup_map (L : IntermediateField K (SeparableClosure K))
    (σ : SeparableClosure K ≃ₐ[K] SeparableClosure K) (u : ℝ) :
    apfSubgroup K (L.map σ.toAlgHom) u = MulAut.conj σ • apfSubgroup K L u := by
  simp only [apfSubgroup, IsGalois.map_fixingSubgroup, Subgroup.smul_sup,
    Subgroup.Normal.conj_smul_eq_self]

theorem apfSubgroup_map_index (L : IntermediateField K (SeparableClosure K))
    (σ : SeparableClosure K ≃ₐ[K] SeparableClosure K) (u : ℝ) :
    (apfSubgroup K (L.map σ.toAlgHom) u).index = (apfSubgroup K L u).index := by
  rw [apfSubgroup_map, Subgroup.pointwise_smul_def]
  exact Subgroup.index_map_equiv _ (MulAut.conj σ)

theorem isAPFSubextension_map_iff (L : IntermediateField K (SeparableClosure K))
    (σ : SeparableClosure K ≃ₐ[K] SeparableClosure K) :
    IsAPFSubextension K (L.map σ.toAlgHom) ↔ IsAPFSubextension K L := by
  simp only [isAPFSubextension_iff_finiteIndex, Subgroup.finiteIndex_iff,
    apfSubgroup_map_index]

variable (L : Type*) [Field L] [Algebra K L] [Algebra.IsSeparable K L]

omit [IsCompleteDiscreteValuedField K] in
/-- Every abstract separable extension has a separable-closure embedding. -/
theorem nonempty_separableClosure_embeddings : Nonempty (L →ₐ[K] SeparableClosure K) :=
  ⟨IsSepClosed.lift⟩

omit [IsCompleteDiscreteValuedField K] [Algebra.IsSeparable K L] in
/-- Two separable-closure embeddings are conjugate by an automorphism. -/
theorem exists_aut_comp_separableClosure_embeddings
    (i j : L →ₐ[K] SeparableClosure K) :
    ∃ σ : SeparableClosure K ≃ₐ[K] SeparableClosure K, σ.toAlgHom.comp i = j := by
  let e := i.equivFieldRange.symm.trans j.equivFieldRange
  let σ := e.liftNormal (SeparableClosure K)
  refine ⟨σ, ?_⟩
  ext x
  simpa [σ, e] using AlgEquiv.liftNormal_commutes e (SeparableClosure K)
    (i.equivFieldRange x)

omit [Algebra.IsSeparable K L] in
theorem isAPFSubextension_fieldRange_iff (i j : L →ₐ[K] SeparableClosure K) :
    IsAPFSubextension K i.fieldRange ↔ IsAPFSubextension K j.fieldRange := by
  obtain ⟨σ, hσ⟩ := exists_aut_comp_separableClosure_embeddings K L i j
  have hr : i.fieldRange.map σ.toAlgHom = j.fieldRange := by
    rw [AlgHom.map_fieldRange, hσ]
  rw [← hr]
  exact (isAPFSubextension_map_iff K i.fieldRange σ).symm

/-- Arithmetic profiniteness of an abstract separable field extension `L/K`
(Wintenberger 1.2.1): the image of every `K`-embedding `L → K^sep` is an APF subextension. -/
class IsAPF (L : Type*) [Field L] [Algebra K L] [Algebra.IsSeparable K L] : Prop where
  isAPFSubextension (i : L →ₐ[K] SeparableClosure K) : IsAPFSubextension K i.fieldRange

attribute [instance] IsAPF.isAPFSubextension

/-- The public APF predicate can be tested using any specified embedding. -/
theorem isAPF_iff_embedding (i : L →ₐ[K] SeparableClosure K) :
    IsAPF K L ↔ IsAPFSubextension K i.fieldRange := by
  constructor
  · exact fun h ↦ h.isAPFSubextension i
  · intro h
    exact ⟨fun j => (isAPFSubextension_fieldRange_iff K L i j).mp h⟩

/-- The embedding quantifier in `IsAPF` is nonvacuous. -/
theorem isAPF_iff_exists_embedding :
    IsAPF K L ↔ ∃ i : L →ₐ[K] SeparableClosure K, IsAPFSubextension K i.fieldRange := by
  constructor
  · intro h
    obtain ⟨i⟩ := nonempty_separableClosure_embeddings K L
    exact ⟨i, h.isAPFSubextension i⟩
  · rintro ⟨i, hi⟩
    exact (isAPF_iff_embedding K L i).mpr hi

theorem isAPF_iff_subextension (E : IntermediateField K (SeparableClosure K)) :
    IsAPF K E ↔ IsAPFSubextension K E := by
  simpa only [IntermediateField.fieldRange_val] using isAPF_iff_embedding K E E.val

instance (E : IntermediateField K (SeparableClosure K)) [IsAPFSubextension K E] : IsAPF K E :=
  (isAPF_iff_subextension K E).mpr ‹_›

instance (E : IntermediateField K (SeparableClosure K)) [IsAPF K E] : IsAPFSubextension K E :=
  (isAPF_iff_subextension K E).mp ‹_›

/-- Every finite separable abstract extension is APF (Wintenberger 1.2.2). -/
instance isAPF_of_finite [FiniteDimensional K L] : IsAPF K L := by
  refine ⟨fun i => ?_⟩
  let : FiniteDimensional K i.fieldRange := Module.Finite.equiv i.equivFieldRange.toLinearEquiv
  exact isAPFSubextension_of_finite K i.fieldRange

variable {L}
variable {M : Type*} [Field M] [Algebra K M] [Algebra.IsSeparable K M]

/-- APF descends along every algebra embedding, including nonnormal subextensions
(Wintenberger 1.2.3 (iii)). -/
theorem IsAPF.of_algHom [hL : IsAPF K L] (f : M →ₐ[K] L) : IsAPF K M := by
  obtain ⟨i⟩ := nonempty_separableClosure_embeddings K L
  have hr : (i.comp f).fieldRange ≤ i.fieldRange := by
    intro x hx
    obtain ⟨a, ha⟩ := AlgHom.mem_fieldRange.mp hx
    exact AlgHom.mem_fieldRange.mpr ⟨f a, ha⟩
  have := hL.isAPFSubextension i
  exact (isAPF_iff_embedding K M (i.comp f)).mpr (IsAPFSubextension.of_le K hr)

/-- Every intermediate field of an APF extension is APF over the base. -/
instance IsAPF.intermediateField [IsAPF K L] (E : IntermediateField K L) : IsAPF K E :=
  IsAPF.of_algHom K E.val

theorem isAPF_algEquiv (e : L ≃ₐ[K] M) : IsAPF K L ↔ IsAPF K M := by
  constructor
  · exact fun h ↦ haveI := h; IsAPF.of_algHom K e.symm.toAlgHom
  · exact fun h ↦ haveI := h; IsAPF.of_algHom K e.toAlgHom

end FontaineWintenberger

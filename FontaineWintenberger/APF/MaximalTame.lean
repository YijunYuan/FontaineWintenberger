/-!
# The maximal unramified and tame parts of an APF extension

Actual absolute inertia and wild inertia determine finite maximal
unramified and tame subfields inside the original abstract extension.
The residue and wild-degree conclusions refer to the original fields.
-/

@[expose] public section

noncomputable section

namespace FontaineWintenberger

section FiniteGroups

variable {G : Type*} [Group G] [Finite G]

/-- In a finite inertia group, a subgroup has prime-to-p relative index
exactly when it contains the normal wild p-subgroup. -/
theorem coprime_relIndex_iff_le_of_normal_pGroup (q : ℕ) [Fact q.Prime]
    (J I P : Subgroup G) [P.Normal] (hPI : P ≤ I) (hP : IsPGroup q P)
    (hquot : Nat.Coprime q (P.relIndex I)) :
    Nat.Coprime q (J.relIndex I) ↔ P ≤ J := by
  let H := J ⊓ I
  have heq : H.relIndex I = J.relIndex I := Subgroup.inf_relIndex_right J I
  constructor
  · intro hc
    have hdiv : H.relIndex P ∣ J.relIndex I := by
      rw [← heq, ← Subgroup.relIndex_mul_relIndex H (H ⊔ P) I le_sup_left
        (sup_le inf_le_right hPI), relIndex_sup_eq_relIndex_of_normal_right]
      exact ⟨(H ⊔ P).relIndex I, by ring⟩
    have hcard := Subgroup.relIndex_dvd_card H P
    obtain ⟨n, hn⟩ := IsPGroup.iff_card.mp hP
    rw [hn] at hcard
    obtain ⟨r, _hr, hpow⟩ := (Nat.dvd_prime_pow (Fact.out : q.Prime)).mp hcard
    have hdivpow : q ^ r ∣ J.relIndex I := hpow ▸ hdiv
    have hg := (hc.pow_left r).gcd_eq_one
    rw [Nat.gcd_eq_left hdivpow] at hg
    have hindex : H.relIndex P = 1 := hpow.trans hg
    exact (Subgroup.relIndex_eq_one.mp hindex).trans inf_le_left
  · intro hPJ
    have hdiv : J.relIndex I ∣ P.relIndex I := by
      rw [← heq, ← Subgroup.relIndex_mul_relIndex P H I (le_inf hPJ hPI) inf_le_right]
      exact ⟨P.relIndex H, by ring⟩
    exact hquot.of_dvd_right hdiv

end FiniteGroups

variable (K : Type*) [NontriviallyNormedField K] [IsPerfectResidueLocalField K]

local notation "p" => residueChar K

/-- Actual absolute wild inertia is the closed subgroup generated by the
positive absolute upper ramification groups. -/
def absoluteWildInertia : Subgroup (SeparableClosure K ≃ₐ[K] SeparableClosure K) :=
  (⨆ u : {u : ℝ // 0 < u}, absoluteUpperRamificationGroup K u.val).topologicalClosure

instance absoluteWildInertia_normal : (absoluteWildInertia K).Normal :=
  Subgroup.is_normal_topologicalClosure _

theorem isClosed_absoluteWildInertia :
    IsClosed (absoluteWildInertia K : Set (SeparableClosure K ≃ₐ[K] SeparableClosure K)) :=
  Subgroup.isClosed_topologicalClosure _

/-- Every positive original upper group lies in actual wild inertia. -/
theorem absoluteUpper_le_absoluteWildInertia {u : ℝ} (hu : 0 < u) :
    absoluteUpperRamificationGroup K u ≤ absoluteWildInertia K :=
  (le_iSup (fun v : {v : ℝ // 0 < v} => absoluteUpperRamificationGroup K v.val)
    ⟨u, hu⟩).trans (Subgroup.le_topologicalClosure _)

/-- Actual absolute wild inertia lies in actual absolute inertia. -/
theorem absoluteWildInertia_le_inertia :
    absoluteWildInertia K ≤ absoluteUpperRamificationGroup K 0 := by
  have hle : (⨆ u : {u : ℝ // 0 < u}, absoluteUpperRamificationGroup K u.val) ≤
      absoluteUpperRamificationGroup K 0 := by
    apply iSup_le
    intro u
    exact upperRamificationGroupInfinite_antitoneOn K (SeparableClosure K)
      (by norm_num : -1 ≤ (0 : ℝ))
      (show -1 ≤ u.val by linarith [u.property]) u.property.le
  exact Subgroup.topologicalClosure_minimal _ hle
    (isClosed_upperRamificationGroupInfinite K (SeparableClosure K) 0)

/-- The original fixing subgroup together with actual absolute wild inertia. -/
def apfTameSubgroup (L : IntermediateField K (SeparableClosure K)) :
    Subgroup (SeparableClosure K ≃ₐ[K] SeparableClosure K) :=
  L.fixingSubgroup ⊔ absoluteWildInertia K

/-- Compactness of the actual product gives closedness, without normality
of the original extension. -/
theorem isClosed_apfTameSubgroup (L : IntermediateField K (SeparableClosure K)) :
    IsClosed (apfTameSubgroup K L : Set (SeparableClosure K ≃ₐ[K] SeparableClosure K)) := by
  let : T2Space (SeparableClosure K ≃ₐ[K] SeparableClosure K) := krullTopology_t2
  rw [apfTameSubgroup, Subgroup.mul_normal]
  exact ((InfiniteGalois.fixingSubgroup_isClosed L).isCompact.mul
    (isClosed_absoluteWildInertia K).isCompact).isClosed

/-- APF openness at upper parameter one proves the actual tame product is open. -/
theorem isOpen_apfTameSubgroup (L : IntermediateField K (SeparableClosure K))
    [IsAPFSubextension K L] :
    IsOpen (apfTameSubgroup K L : Set (SeparableClosure K ≃ₐ[K] SeparableClosure K)) :=
  Subgroup.isOpen_mono (sup_le_sup_left
    (absoluteUpper_le_absoluteWildInertia K (by norm_num : (0 : ℝ) < 1)) _)
    (IsAPFSubextension.isOpen_apfSubgroup 1 (by norm_num))

/-- The original separable-closure field fixed by the actual tame product. -/
def apfTameStage (L : IntermediateField K (SeparableClosure K)) :
    IntermediateField K (SeparableClosure K) :=
  IntermediateField.fixedField (apfTameSubgroup K L)

theorem fixingSubgroup_apfTameStage (L : IntermediateField K (SeparableClosure K)) :
    (apfTameStage K L).fixingSubgroup = apfTameSubgroup K L :=
  InfiniteGalois.fixingSubgroup_fixedField
    ⟨apfTameSubgroup K L, isClosed_apfTameSubgroup K L⟩

theorem apfTameStage_le (L : IntermediateField K (SeparableClosure K)) :
    apfTameStage K L ≤ L :=
  (IntermediateField.fixedField_le
    (show L.fixingSubgroup ≤ apfTameSubgroup K L from le_sup_left)).trans_eq
      (InfiniteGalois.fixedField_fixingSubgroup L)

/-- The actual tame fixed field has genuinely finite degree over the original base. -/
theorem finiteDimensional_apfTameStage (L : IntermediateField K (SeparableClosure K))
    [IsAPFSubextension K L] : FiniteDimensional K (apfTameStage K L) := by
  apply (InfiniteGalois.isOpen_iff_finite _).mp
  rw [fixingSubgroup_apfTameStage]
  exact isOpen_apfTameSubgroup K L

/-- The actual inertia-fixed stage is contained in the actual tame stage. -/
theorem apfFiniteStage_zero_le_tameStage (L : IntermediateField K (SeparableClosure K)) :
    apfFiniteStage K L 0 ≤ apfTameStage K L :=
  IntermediateField.fixedField_le
    (sup_le_sup_left (absoluteWildInertia_le_inertia K) L.fixingSubgroup)

/-- Actual absolute wild inertia projects onto the actual first lower
group in every original finite Galois subextension. -/
theorem absoluteWildInertia_map
    (E : FiniteGaloisIntermediateField K (SeparableClosure K)) :
    (absoluteWildInertia K).map (AlgEquiv.restrictNormalHom E) =
      lowerRamificationGroup (E ≃ₐ[K] E)
        (IsLocalRing.maximalIdeal (spectralIntegerRing K E)) 1 := by
  let ρ : (SeparableClosure K ≃ₐ[K] SeparableClosure K) →* (E ≃ₐ[K] E) :=
    AlgEquiv.restrictNormalHom E
  let P := lowerRamificationGroup (E ≃ₐ[K] E)
    (IsLocalRing.maximalIdeal (spectralIntegerRing K E)) 1
  have hclosed : IsClosed (P.comap ρ : Set (SeparableClosure K ≃ₐ[K] SeparableClosure K)) := by
    let : T2Space (E ≃ₐ[K] E) := krullTopology_t2
    exact (Set.toFinite (P : Set (E ≃ₐ[K] E))).isClosed.preimage
      (InfiniteGalois.restrictNormalHom_continuous E.toIntermediateField)
  have hgen : (⨆ u : {u : ℝ // 0 < u}, absoluteUpperRamificationGroup K u.val) ≤ P.comap ρ := by
    apply iSup_le
    intro u
    rw [← Subgroup.map_le_iff_le_comap]
    change (absoluteUpperRamificationGroup K u.val).map (AlgEquiv.restrictNormalHom E) ≤ P
    rw [absolute_map_upperRamificationGroup K E u.val (by linarith [u.property])]
    exact upperRamificationGroup_le_lower_one (E ≃ₐ[K] E) u.property
  apply le_antisymm
  · exact Subgroup.map_le_iff_le_comap.mpr
      (Subgroup.topologicalClosure_minimal _ hgen hclosed)
  · let u := herbrandFunction (R := spectralIntegerRing K E) (E ≃ₐ[K] E) 1
    have hu : 0 < u := by
      have h := strictMonoOn_herbrandFunction (R := spectralIntegerRing K E) (E ≃ₐ[K] E)
        (by norm_num : -1 ≤ (0 : ℝ)) (by norm_num : -1 ≤ (1 : ℝ)) (by norm_num : (0 : ℝ) < 1)
      rw [herbrandFunction_of_nonpos (E ≃ₐ[K] E) (t := 0) le_rfl] at h
      exact h
    have h := Subgroup.map_mono (f := AlgEquiv.restrictNormalHom E)
      (absoluteUpper_le_absoluteWildInertia K hu)
    rw [absolute_map_upperRamificationGroup K E u (by linarith)] at h
    have heq : upperRamificationGroup (R := spectralIntegerRing K E) (E ≃ₐ[K] E) u = P := by
      dsimp only [u]
      rw [upperRamificationGroup_herbrandFunction (E ≃ₐ[K] E) (by norm_num)]
      simpa only [Int.cast_one, P] using lowerRamificationGroupReal_intCast (E ≃ₐ[K] E)
        (IsLocalRing.maximalIdeal (spectralIntegerRing K E)) 1
    rw [heq] at h
    exact h

/-- An arbitrary intermediate field of an original finite Galois
extension is unramified exactly when actual inertia fixes it. -/
theorem intermediate_spectral_ramificationIdx_eq_one_iff_inertia_le
    (Ω : Type*) [Field Ω] [Algebra K Ω] [FiniteDimensional K Ω] [IsGalois K Ω]
    (M : IntermediateField K Ω) :
    (IsLocalRing.maximalIdeal (spectralIntegerRing K M)).ramificationIdx
        (NormedField.valuation (K := K)).valuationSubring = 1 ↔
      lowerRamificationGroup (Ω ≃ₐ[K] Ω)
        (IsLocalRing.maximalIdeal (spectralIntegerRing K Ω)) 0 ≤ M.fixingSubgroup := by
  rw [intermediate_spectral_ramificationIdx_eq_relIndex K Ω M, Subgroup.relIndex_eq_one]

/-- An arbitrary original finite intermediate field is tame exactly when
the actual wild inertia subgroup fixes it. -/
theorem intermediate_spectral_ramificationIdx_coprime_iff_wild_le
    (Ω : Type*) [Field Ω] [Algebra K Ω] [FiniteDimensional K Ω] [IsGalois K Ω]
    (M : IntermediateField K Ω) :
    Nat.Coprime p ((IsLocalRing.maximalIdeal (spectralIntegerRing K M)).ramificationIdx
      (NormedField.valuation (K := K)).valuationSubring) ↔
      lowerRamificationGroup (Ω ≃ₐ[K] Ω)
        (IsLocalRing.maximalIdeal (spectralIntegerRing K Ω)) 1 ≤ M.fixingSubgroup := by
  let : CharP (IsLocalRing.ResidueField (spectralIntegerRing K Ω)) p :=
    charP_of_injective_algebraMap
      (algebraMap (IsLocalRing.ResidueField
        (NormedField.valuation (K := K)).valuationSubring)
        (IsLocalRing.ResidueField (spectralIntegerRing K Ω))).injective p
  rw [intermediate_spectral_ramificationIdx_eq_relIndex K Ω M]
  have hc := wild_fixedField_ramificationIdx_coprime K Ω p
  rw [wild_fixedField_ramificationIdx_eq_relIndex K Ω] at hc
  exact coprime_relIndex_iff_le_of_normal_pGroup p _ _ _
    (lowerRamificationGroup_antitone (Ω ≃ₐ[K] Ω)
      (IsLocalRing.maximalIdeal (spectralIntegerRing K Ω)) (by norm_num : (0 : ℤ) ≤ 1))
    (lowerRamificationGroup_one_isPGroup (Ω ≃ₐ[K] Ω) p) hc

/-- A finite original separable subfield is unramified exactly when the
actual absolute inertia fixes it, without normality of the subfield. -/
theorem spectral_ramificationIdx_eq_one_iff_absoluteInertia_le
    (M : IntermediateField K (SeparableClosure K)) [FiniteDimensional K M] :
    (IsLocalRing.maximalIdeal (spectralIntegerRing K M)).ramificationIdx
        (NormedField.valuation (K := K)).valuationSubring = 1 ↔
      absoluteUpperRamificationGroup K 0 ≤ M.fixingSubgroup := by
  let Ω := finiteGaloisNormalClosure K M
  let f : M →ₐ[K] Ω := M.val.codRestrict Ω.toIntermediateField.toSubalgebra
    (fun x => le_finiteGaloisNormalClosure K M x.property)
  let N := f.fieldRange
  have : FiniteDimensional K N := Module.Finite.equiv f.equivFieldRange.toLinearEquiv
  have hmap : N.map Ω.toIntermediateField.val = M := by
    change f.fieldRange.map Ω.toIntermediateField.val = M
    rw [AlgHom.map_fieldRange]
    have heq : Ω.toIntermediateField.val.comp f = M.val := by ext x; rfl
    rw [heq, IntermediateField.fieldRange_val]
  have hfix : M.fixingSubgroup = N.fixingSubgroup.comap (AlgEquiv.restrictNormalHom Ω) := by
    rw [← hmap]
    exact IntermediateField.map_fixingSubgroup
      (F := K) (E := Ω) (E' := SeparableClosure K) (L := N)
  rw [hfix, ← Subgroup.map_le_iff_le_comap,
    absolute_map_upperRamificationGroup K Ω 0 (by norm_num), upperRamificationGroup_zero,
    ← lowerRamificationGroup_zero,
    ← intermediate_spectral_ramificationIdx_eq_one_iff_inertia_le K Ω N,
    spectral_ramificationIdx_algEquiv K f.equivFieldRange]

/-- A finite original separable subfield is tame exactly when actual
absolute wild inertia fixes it, without normality of the subfield. -/
theorem spectral_ramificationIdx_coprime_iff_absoluteWildInertia_le
    (M : IntermediateField K (SeparableClosure K)) [FiniteDimensional K M] :
    Nat.Coprime p ((IsLocalRing.maximalIdeal (spectralIntegerRing K M)).ramificationIdx
      (NormedField.valuation (K := K)).valuationSubring) ↔
      absoluteWildInertia K ≤ M.fixingSubgroup := by
  let Ω := finiteGaloisNormalClosure K M
  let f : M →ₐ[K] Ω := M.val.codRestrict Ω.toIntermediateField.toSubalgebra
    (fun x => le_finiteGaloisNormalClosure K M x.property)
  let N := f.fieldRange
  have : FiniteDimensional K N := Module.Finite.equiv f.equivFieldRange.toLinearEquiv
  have hmap : N.map Ω.toIntermediateField.val = M := by
    change f.fieldRange.map Ω.toIntermediateField.val = M
    rw [AlgHom.map_fieldRange]
    have heq : Ω.toIntermediateField.val.comp f = M.val := by ext x; rfl
    rw [heq, IntermediateField.fieldRange_val]
  have hfix : M.fixingSubgroup = N.fixingSubgroup.comap (AlgEquiv.restrictNormalHom Ω) := by
    rw [← hmap]
    exact IntermediateField.map_fixingSubgroup
      (F := K) (E := Ω) (E' := SeparableClosure K) (L := N)
  rw [hfix, ← Subgroup.map_le_iff_le_comap, absoluteWildInertia_map K Ω,
    ← intermediate_spectral_ramificationIdx_coprime_iff_wild_le K Ω N,
    spectral_ramificationIdx_algEquiv K f.equivFieldRange]

/-- Among original finite subfields, the actual inertia-fixed stage is
exactly the maximal unramified part of the given subextension. -/
theorem le_apfFiniteStage_zero_iff_ramificationIdx_eq_one
    (L M : IntermediateField K (SeparableClosure K)) [FiniteDimensional K M]
    (hML : M ≤ L) :
    M ≤ apfFiniteStage K L 0 ↔
      (IsLocalRing.maximalIdeal (spectralIntegerRing K M)).ramificationIdx
        (NormedField.valuation (K := K)).valuationSubring = 1 := by
  rw [spectral_ramificationIdx_eq_one_iff_absoluteInertia_le K M]
  constructor
  · intro h
    have hf := IntermediateField.fixingSubgroup_le h
    rw [fixingSubgroup_apfFiniteStage] at hf
    exact le_sup_right.trans hf
  · intro h
    exact (InfiniteGalois.fixedField_fixingSubgroup M).symm.trans_le
      (IntermediateField.fixedField_le
        (show apfSubgroup K L 0 ≤ M.fixingSubgroup from
          sup_le (IntermediateField.fixingSubgroup_le hML) h))

/-- Among original finite subfields, the actual wild-inertia-fixed stage
is exactly the maximal tame part of the given subextension. -/
theorem le_apfTameStage_iff_ramificationIdx_coprime
    (L M : IntermediateField K (SeparableClosure K)) [FiniteDimensional K M]
    (hML : M ≤ L) :
    M ≤ apfTameStage K L ↔
      Nat.Coprime p ((IsLocalRing.maximalIdeal (spectralIntegerRing K M)).ramificationIdx
        (NormedField.valuation (K := K)).valuationSubring) := by
  rw [spectral_ramificationIdx_coprime_iff_absoluteWildInertia_le K M]
  constructor
  · intro h
    have hf := IntermediateField.fixingSubgroup_le h
    rw [fixingSubgroup_apfTameStage] at hf
    exact le_sup_right.trans hf
  · intro h
    exact (InfiniteGalois.fixedField_fixingSubgroup M).symm.trans_le
      (IntermediateField.fixedField_le
        (show apfTameSubgroup K L ≤ M.fixingSubgroup from
          sup_le (IntermediateField.fixingSubgroup_le hML) h))

/-- Above the actual tame fixed stage, every finite step of the original
separable extension has p-power degree, including nonnormal steps. -/
theorem finrank_eq_prime_pow_of_apfTameStage_le
    (L E F : IntermediateField K (SeparableClosure K)) [FiniteDimensional K F]
    (hFL : F ≤ L) (hEF : E ≤ F) (hstage : apfTameStage K L ≤ E) :
    ∃ n : ℕ, Module.finrank E (IntermediateField.extendScalars hEF) = p ^ n := by
  let Ω := finiteGaloisNormalClosure K F
  let M := E.comap Ω.toIntermediateField.val
  let N := F.comap Ω.toIntermediateField.val
  have hFΩ : F ≤ Ω.toIntermediateField := le_finiteGaloisNormalClosure K F
  have hEΩ : E ≤ Ω.toIntermediateField := hEF.trans hFΩ
  have hM : M.map Ω.toIntermediateField.val = E := by
    ext x
    constructor
    · rintro ⟨y, hy, rfl⟩
      exact hy
    · intro hx
      exact ⟨⟨x, hEΩ hx⟩, hx, rfl⟩
  have hN : N.map Ω.toIntermediateField.val = F := by
    ext x
    constructor
    · rintro ⟨y, hy, rfl⟩
      exact hy
    · intro hx
      exact ⟨⟨x, hFΩ hx⟩, hx, rfl⟩
  let ρ : (SeparableClosure K ≃ₐ[K] SeparableClosure K) →* (Ω ≃ₐ[K] Ω) :=
    AlgEquiv.restrictNormalHom Ω
  let A := L.fixingSubgroup.map ρ
  let B := N.fixingSubgroup
  let C := M.fixingSubgroup
  let U := lowerRamificationGroup (Ω ≃ₐ[K] Ω)
    (IsLocalRing.maximalIdeal (spectralIntegerRing K Ω)) 1
  have hρ : Function.Surjective ρ :=
    AlgEquiv.restrictNormalHom_surjective (F := K) (K₁ := Ω) (SeparableClosure K)
  have hfixE : E.fixingSubgroup = C.comap ρ := by
    rw [← hM]
    exact IntermediateField.map_fixingSubgroup (F := K) (E := Ω)
      (E' := SeparableClosure K) (L := M)
  have hfixF : F.fixingSubgroup = B.comap ρ := by
    rw [← hN]
    exact IntermediateField.map_fixingSubgroup (F := K) (E := Ω)
      (E' := SeparableClosure K) (L := N)
  have hmapE : E.fixingSubgroup.map ρ = C := by
    rw [hfixE, Subgroup.map_comap_eq, MonoidHom.range_eq_top.mpr hρ, top_inf_eq]
  have hmapF : F.fixingSubgroup.map ρ = B := by
    rw [hfixF, Subgroup.map_comap_eq, MonoidHom.range_eq_top.mpr hρ, top_inf_eq]
  have hAB : A ≤ B := by
    rw [← hmapF]
    exact Subgroup.map_mono (IntermediateField.fixingSubgroup_le hFL)
  have hBC : B ≤ C :=
    IntermediateField.fixingSubgroup_le (show M ≤ N from fun _ hx => hEF hx)
  have hCU : C ≤ A ⊔ U := by
    have hfix : E.fixingSubgroup ≤ apfTameSubgroup K L :=
      (IntermediateField.fixingSubgroup_le hstage).trans_eq
        (fixingSubgroup_apfTameStage K L)
    have h := Subgroup.map_mono (f := ρ) hfix
    rw [hmapE] at h
    change C ≤ (L.fixingSubgroup ⊔ absoluteWildInertia K).map ρ at h
    rw [Subgroup.map_sup, absoluteWildInertia_map K Ω] at h
    exact h
  have hU : IsPGroup p U := by
    let : CharP (IsLocalRing.ResidueField (spectralIntegerRing K Ω)) p :=
      charP_of_injective_algebraMap
        (algebraMap (IsLocalRing.ResidueField
          (NormedField.valuation (K := K)).valuationSubring)
          (IsLocalRing.ResidueField (spectralIntegerRing K Ω))).injective p
    exact lowerRamificationGroup_one_isPGroup (Ω ≃ₐ[K] Ω) p
  obtain ⟨n, hn⟩ := relIndex_eq_prime_pow_of_le_sup p A B C U hU hAB hBC hCU
  refine ⟨n, ?_⟩
  rw [← fixingSubgroup_relIndex_eq_finrank K E F hEF, hfixF,
    Subgroup.relIndex_comap, hmapE]
  exact hn

section AbstractExtension

variable (L : Type*) [Field L] [Algebra K L] [Algebra.IsSeparable K L]

/-- The actual tame fixed stage pulls back to a genuinely finite subfield
of the original abstract extension under every specified separable embedding. -/
theorem IsAPF.exists_finiteIntermediateField_map_eq_apfTameStage [IsAPF K L]
    (j : L →ₐ[K] SeparableClosure K) :
    ∃ E : FiniteIntermediateField K L, E.val.map j = apfTameStage K j.fieldRange := by
  let A := apfTameStage K j.fieldRange
  have : FiniteDimensional K A := finiteDimensional_apfTameStage K j.fieldRange
  let f : A →ₐ[K] L := j.equivFieldRange.symm.toAlgHom.comp
    (IntermediateField.inclusion (apfTameStage_le K j.fieldRange))
  let E : FiniteIntermediateField K L :=
    ⟨f.fieldRange, Module.Finite.equiv f.equivFieldRange.toLinearEquiv⟩
  refine ⟨E, ?_⟩
  change f.fieldRange.map j = A
  rw [AlgHom.map_fieldRange]
  have he : j.comp f = A.val := by
    apply AlgHom.ext
    intro x
    exact congrArg (fun z : j.fieldRange => (z : SeparableClosure K))
      (j.equivFieldRange.apply_symm_apply
        (IntermediateField.inclusion (apfTameStage_le K j.fieldRange) x))
  rw [he, IntermediateField.fieldRange_val]

/-- The actual finite maximal unramified subfield of the original abstract APF extension. -/
def apfMaximalUnramified [IsAPF K L] : FiniteIntermediateField K L :=
  (exists_finiteIntermediateField_map_eq_apfFiniteStage K L
    (IsSepClosed.lift : L →ₐ[K] SeparableClosure K) (by norm_num : -1 ≤ (0 : ℝ))).choose

/-- The actual finite maximal tame subfield of the original abstract APF extension. -/
def apfMaximalTame [IsAPF K L] : FiniteIntermediateField K L :=
  (IsAPF.exists_finiteIntermediateField_map_eq_apfTameStage K L
    (IsSepClosed.lift : L →ₐ[K] SeparableClosure K)).choose

private theorem apfMaximalUnramified_map [IsAPF K L] :
    (apfMaximalUnramified K L).val.map (IsSepClosed.lift : L →ₐ[K] SeparableClosure K) =
      apfFiniteStage K (IsSepClosed.lift : L →ₐ[K] SeparableClosure K).fieldRange 0 :=
  (exists_finiteIntermediateField_map_eq_apfFiniteStage K L
    (IsSepClosed.lift : L →ₐ[K] SeparableClosure K) (by norm_num : -1 ≤ (0 : ℝ))).choose_spec

private theorem apfMaximalTame_map [IsAPF K L] :
    (apfMaximalTame K L).val.map (IsSepClosed.lift : L →ₐ[K] SeparableClosure K) =
      apfTameStage K (IsSepClosed.lift : L →ₐ[K] SeparableClosure K).fieldRange :=
  (IsAPF.exists_finiteIntermediateField_map_eq_apfTameStage K L
    (IsSepClosed.lift : L →ₐ[K] SeparableClosure K)).choose_spec

omit [IsPerfectResidueLocalField K] [Algebra.IsSeparable K L] in
private theorem FiniteIntermediateField.map_le_map_iff (j : L →ₐ[K] SeparableClosure K)
    (E F : FiniteIntermediateField K L) : E.val.map j ≤ F.val.map j ↔ E ≤ F := by
  constructor
  · intro h x hx
    exact (F.val.map_mem_map j).mp
      (h ((E.val.map_mem_map j).mpr hx))
  · exact IntermediateField.map_mono j

/-- A finite subfield of the original extension is contained in its actual
maximal unramified part exactly when its original ramification index is one. -/
theorem le_apfMaximalUnramified_iff [IsAPF K L] (E : FiniteIntermediateField K L) :
    E ≤ apfMaximalUnramified K L ↔
      (IsLocalRing.maximalIdeal (spectralIntegerRing K E.val)).ramificationIdx
        (NormedField.valuation (K := K)).valuationSubring = 1 := by
  let j : L →ₐ[K] SeparableClosure K := IsSepClosed.lift
  have : FiniteDimensional K (E.val.map j) :=
    Module.Finite.equiv (IntermediateField.equivMap E.val j).toLinearEquiv
  have hEL : E.val.map j ≤ j.fieldRange := by
    rintro x ⟨y, _, rfl⟩
    exact ⟨y, rfl⟩
  have hc := le_apfFiniteStage_zero_iff_ramificationIdx_eq_one K j.fieldRange
    (E.val.map j) hEL
  rw [← apfMaximalUnramified_map K L,
    spectral_ramificationIdx_algEquiv K (IntermediateField.equivMap E.val j)] at hc
  exact (FiniteIntermediateField.map_le_map_iff K L j E (apfMaximalUnramified K L)).symm.trans hc

/-- The unramified finite subfields have the stated greatest element;
this universal property also gives its uniqueness. -/
theorem isGreatest_apfMaximalUnramified [IsAPF K L] :
    IsGreatest {E : FiniteIntermediateField K L |
      (IsLocalRing.maximalIdeal (spectralIntegerRing K E.val)).ramificationIdx
        (NormedField.valuation (K := K)).valuationSubring = 1}
      (apfMaximalUnramified K L) :=
  ⟨(le_apfMaximalUnramified_iff K L _).mp le_rfl,
    fun E hE => (le_apfMaximalUnramified_iff K L E).mpr hE⟩

/-- Actual inclusion of the maximal unramified part in the maximal tame part. -/
theorem apfMaximalUnramified_le_maximalTame [IsAPF K L] :
    apfMaximalUnramified K L ≤ apfMaximalTame K L := by
  let j : L →ₐ[K] SeparableClosure K := IsSepClosed.lift
  apply (FiniteIntermediateField.map_le_map_iff K L j _ _).mp
  rw [apfMaximalUnramified_map K L, apfMaximalTame_map K L]
  exact apfFiniteStage_zero_le_tameStage K j.fieldRange

/-- Every finite intermediate field above the actual maximal unramified part has its
original residue degree, with no normality assumption. -/
theorem residueDegree_eq_apfMaximalUnramified [IsAPF K L]
    (E : FiniteIntermediateField K L) (hE : apfMaximalUnramified K L ≤ E) :
    Module.finrank (IsLocalRing.ResidueField
        (NormedField.valuation (K := K)).valuationSubring)
      (IsLocalRing.ResidueField (spectralIntegerRing K E.val)) =
    Module.finrank (IsLocalRing.ResidueField
        (NormedField.valuation (K := K)).valuationSubring)
      (IsLocalRing.ResidueField
        (spectralIntegerRing K (apfMaximalUnramified K L).val)) := by
  let j : L →ₐ[K] SeparableClosure K := IsSepClosed.lift
  have : FiniteDimensional K (E.val.map j) :=
    Module.Finite.equiv (IntermediateField.equivMap E.val j).toLinearEquiv
  have hEL : E.val.map j ≤ j.fieldRange := by
    rintro x ⟨y, _, rfl⟩
    exact ⟨y, rfl⟩
  have hstage : apfFiniteStage K j.fieldRange 0 ≤ E.val.map j := by
    rw [← apfMaximalUnramified_map K L]
    exact IntermediateField.map_mono j hE
  have hd := residueDegree_eq_zeroStage_of_apfFiniteStage_le K j.fieldRange
    (E.val.map j) hEL hstage
  rw [← apfMaximalUnramified_map K L,
    spectral_residueDegree_algEquiv K E.val (IntermediateField.equivMap E.val j),
    spectral_residueDegree_algEquiv K (apfMaximalUnramified K L).val
      (IntermediateField.equivMap (apfMaximalUnramified K L).val j)] at hd
  exact hd

/-- All actual finite residue inclusions above the maximal unramified
part are onto. -/
theorem spectralResidueInclusion_surjective_of_apfMaximalUnramified_le
    [IsAPF K L] (E F : FiniteIntermediateField K L)
    (hE : apfMaximalUnramified K L ≤ E) (hEF : E ≤ F) :
    Function.Surjective (spectralResidueInclusion K (IntermediateField.inclusion hEF)) := by
  have hd := (residueDegree_eq_apfMaximalUnramified K L E hE).trans
    (residueDegree_eq_apfMaximalUnramified K L F (hE.trans hEF)).symm
  exact (LinearMap.injective_iff_surjective_of_finrank_eq_finrank hd
    (f := (spectralResidueInclusion K (IntermediateField.inclusion hEF)).toLinearMap)).mp
      (spectralResidueInclusion K (IntermediateField.inclusion hEF)).injective

/-- Every finite intermediate field above the maximal unramified part has exactly the
actual residue field of the original infinite extension. -/
theorem spectralResidueInclusion_bijective_of_apfMaximalUnramified_le
    [IsAPF K L] (E : FiniteIntermediateField K L)
    (hE : apfMaximalUnramified K L ≤ E) :
    Function.Bijective (spectralResidueInclusion K E.val.val) := by
  obtain ⟨T, hT⟩ := IsAPF.exists_finiteIntermediateField_spectralResidueInclusion_bijective K L
  let F := FiniteIntermediateField.sup E T
  have hEF : E ≤ F := FiniteIntermediateField.le_sup_left E T
  have hs := spectralResidueInclusion_surjective_of_apfMaximalUnramified_le K L
    E F hE hEF
  have hF := hT F (FiniteIntermediateField.le_sup_right E T)
  have hi : (spectralResidueInclusion K F.val.val).comp
      (spectralResidueInclusion K (IntermediateField.inclusion hEF)) =
      spectralResidueInclusion K E.val.val := by
    rw [← spectralResidueInclusion_comp]
    rfl
  refine ⟨(spectralResidueInclusion K E.val.val).injective, ?_⟩
  rw [← hi]
  exact hF.surjective.comp hs

/-- The canonical integral-closure residue map is bijective already at
the actual maximal unramified part, and at every larger finite intermediate field. -/
theorem integralClosureResidueFromLayer_bijective_of_apfMaximalUnramified_le
    [IsAPF K L] (E : FiniteIntermediateField K L)
    (hE : apfMaximalUnramified K L ≤ E) :
    Function.Bijective (integralClosureResidueFromLayer K L E) :=
  (integralClosureSpectralResidueEquiv K (L := L)).symm.bijective.comp
    (spectralResidueInclusion_bijective_of_apfMaximalUnramified_le K L E hE)

/-- The original inclusion of the maximal unramified part induces the
residue-field equivalence with the canonical integral closure of the original L. -/
def apfMaximalUnramifiedResidueEquiv [IsAPF K L] :
    IsLocalRing.ResidueField (spectralIntegerRing K (apfMaximalUnramified K L).val)
      ≃ₐ[IsLocalRing.ResidueField (NormedField.valuation (K := K)).valuationSubring]
        IsLocalRing.ResidueField
          (integralClosure (NormedField.valuation (K := K)).valuationSubring L) :=
  AlgEquiv.ofBijective (integralClosureResidueFromLayer K L (apfMaximalUnramified K L))
    (integralClosureResidueFromLayer_bijective_of_apfMaximalUnramified_le K L _ le_rfl)

@[simp]
theorem apfMaximalUnramifiedResidueEquiv_apply [IsAPF K L]
    (z : IsLocalRing.ResidueField
      (spectralIntegerRing K (apfMaximalUnramified K L).val)) :
    apfMaximalUnramifiedResidueEquiv K L z =
      integralClosureResidueFromLayer K L (apfMaximalUnramified K L) z := rfl

/-- A finite subfield is in the actual maximal tame part exactly when
its original ramification index is prime to the residue characteristic. -/
theorem le_apfMaximalTame_iff [IsAPF K L] (E : FiniteIntermediateField K L) :
    E ≤ apfMaximalTame K L ↔
      Nat.Coprime p ((IsLocalRing.maximalIdeal (spectralIntegerRing K E.val)).ramificationIdx
        (NormedField.valuation (K := K)).valuationSubring) := by
  let j : L →ₐ[K] SeparableClosure K := IsSepClosed.lift
  have : FiniteDimensional K (E.val.map j) :=
    Module.Finite.equiv (IntermediateField.equivMap E.val j).toLinearEquiv
  have hEL : E.val.map j ≤ j.fieldRange := by
    rintro x ⟨y, _, rfl⟩
    exact ⟨y, rfl⟩
  have hc := le_apfTameStage_iff_ramificationIdx_coprime K j.fieldRange
    (E.val.map j) hEL
  rw [← apfMaximalTame_map K L,
    spectral_ramificationIdx_algEquiv K (IntermediateField.equivMap E.val j)] at hc
  exact (FiniteIntermediateField.map_le_map_iff K L j E (apfMaximalTame K L)).symm.trans hc

/-- The tame finite subfields have the stated greatest element, without
normality of the original extension or of any finite subfield. -/
theorem isGreatest_apfMaximalTame [IsAPF K L] :
    IsGreatest {E : FiniteIntermediateField K L |
      Nat.Coprime p ((IsLocalRing.maximalIdeal (spectralIntegerRing K E.val)).ramificationIdx
        (NormedField.valuation (K := K)).valuationSubring)}
      (apfMaximalTame K L) :=
  ⟨(le_apfMaximalTame_iff K L _).mp le_rfl,
    fun E hE => (le_apfMaximalTame_iff K L E).mpr hE⟩

/-- All actual finite steps above the maximal tame part have p-power
degree, with no normality assumption on either endpoint. -/
theorem finrank_eq_prime_pow_of_apfMaximalTame_le [IsAPF K L]
    (E F : FiniteIntermediateField K L) (hE : apfMaximalTame K L ≤ E) (hEF : E ≤ F) :
    ∃ n : ℕ, Module.finrank E.val (IntermediateField.extendScalars hEF) = p ^ n := by
  let j : L →ₐ[K] SeparableClosure K := IsSepClosed.lift
  have : FiniteDimensional K (F.val.map j) :=
    Module.Finite.equiv (IntermediateField.equivMap F.val j).toLinearEquiv
  have hFL : F.val.map j ≤ j.fieldRange := by
    rintro x ⟨y, _, rfl⟩
    exact ⟨y, rfl⟩
  have hmap : E.val.map j ≤ F.val.map j := IntermediateField.map_mono j hEF
  have hstage : apfTameStage K j.fieldRange ≤ E.val.map j := by
    rw [← apfMaximalTame_map K L]
    exact IntermediateField.map_mono j hE
  obtain ⟨n, hn⟩ := finrank_eq_prime_pow_of_apfTameStage_le K
    j.fieldRange (E.val.map j) (F.val.map j) hFL hmap hstage
  refine ⟨n, ?_⟩
  rw [← IntermediateField.relfinrank_eq_finrank_of_le hmap,
    IntermediateField.relfinrank_map_map,
    IntermediateField.relfinrank_eq_finrank_of_le hEF] at hn
  exact hn

/-- The actual maximal tame part starts the wild tail: every original
finite step has surjective residue map, p-power degree, and ramification
index equal to that full relative degree. -/
theorem apfMaximalTame_wild_tail [IsAPF K L]
    (E F : FiniteIntermediateField K L) (hE : apfMaximalTame K L ≤ E) (hEF : E ≤ F) :
    Function.Surjective
        (spectralResidueInclusion K (IntermediateField.inclusion hEF)) ∧
      (∃ n : ℕ, Module.finrank E.val (IntermediateField.extendScalars hEF) = p ^ n) ∧
      letI : Algebra E.val F.val := (IntermediateField.inclusion hEF).toRingHom.toAlgebra
      letI : IsScalarTower K E.val F.val := IsScalarTower.of_algebraMap_eq' rfl
      letI := spectralValuation_hasExtension_tower K (E := E.val) (L := F.val)
      (IsLocalRing.maximalIdeal (spectralIntegerRing K F.val)).ramificationIdx
          (spectralIntegerRing K E.val) =
        Module.finrank E.val (IntermediateField.extendScalars hEF) := by
  have hs := spectralResidueInclusion_surjective_of_apfMaximalUnramified_le K L E F
    ((apfMaximalUnramified_le_maximalTame K L).trans hE) hEF
  exact ⟨hs, finrank_eq_prime_pow_of_apfMaximalTame_le K L E F hE hEF,
    FiniteIntermediateField.ramificationIdx_eq_finrank_of_residueInclusion_surjective K L E F hEF
        hs⟩


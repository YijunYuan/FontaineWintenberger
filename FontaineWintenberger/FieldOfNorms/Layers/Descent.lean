/-!
# Finite descent in algebraic towers

## Finite descent in an algebraic tower

Finite coefficient fields descend a finite separable extension to finite
intermediate fields. These are the algebraic cofinality producers in
Wintenberger, paragraph 3.1.1, before the field-of-norms covariant construction.

## Algebraic norms under finite tensor descent

The canonical tensor multiplication maps supplied by finite descent preserve
the algebraic norms, by base change of multiplication determinants.

## Main definitions

* `polynomialCoefficientField`: The finite field generated by the coefficients of a polynomial.
* `adjoinTensorEquiv`: The canonical tensor map is an isomorphism after descending the minimal
  polynomial of the primitive element.

## Main results

* `coeff_mem_polynomialCoefficientField`: Every coefficient belongs to its finite coefficient field.
* `polynomial_lifts_coefficientField`: A polynomial lifts along the inclusion of its finite
  coefficient field.
* `polynomial_lifts_of_coefficientField_le`: Enlarging the coefficient field preserves descent of
  the polynomial.
* `exists_finiteIntermediateField_minpoly_lifts`: In an algebraic base extension, all coefficients
  of a minimal polynomial already descend to a finite intermediate field.
* `exists_finiteIntermediateField_minpoly_descent`: The minimal polynomial descends as a monic
  polynomial with the same degree and the root, over a finite coefficient field.
* `finrank_adjoin_eq_of_minpoly_lifts`: Descending the minimal polynomial preserves the degree of
  the simple extension, with no assumed linear-disjointness conclusion.
* `linearDisjoint_adjoin_of_minpoly_lifts`: The simple coefficient-field extension is linearly
  disjoint from the base once the minimal polynomial descends.
* `exists_finiteIntermediateField_adjoin_linearDisjoint`: An algebraic element descends to a finite
  coefficient field whose simple extension is linearly disjoint from the base.

## References

* Wintenberger, *Le corps des normes de certaines extensions infinies de corps locaux;
  applications*, §2–3 (le corps des normes, fonctorialité).
-/

@[expose] public section

noncomputable section

namespace FontaineWintenberger

variable (K : Type*) [Field K] {M : Type*} [Field M] [Algebra K M]
    [Algebra.IsAlgebraic K M]

/-- The finite field generated by the coefficients of a polynomial. -/
def polynomialCoefficientField (q : Polynomial M) : FiniteIntermediateField K M :=
  ⟨IntermediateField.adjoin K (q.coeffs : Set M),
    IntermediateField.finiteDimensional_adjoin (fun x _ => Algebra.IsIntegral.isIntegral x)⟩

/-- Every coefficient belongs to its finite coefficient field. -/
theorem coeff_mem_polynomialCoefficientField (q : Polynomial M) (i : ℕ) :
    q.coeff i ∈ (polynomialCoefficientField K q).val := by
  by_cases h : q.coeff i = 0
  · rw [h]
    exact zero_mem _
  · exact IntermediateField.subset_adjoin K _
      (Polynomial.mem_coeffs_iff.mpr ⟨i, Polynomial.mem_support_iff.mpr h, rfl⟩)

/-- A polynomial lifts along the inclusion of its finite coefficient field. -/
theorem polynomial_lifts_coefficientField (q : Polynomial M) :
    q ∈ Polynomial.lifts (algebraMap (polynomialCoefficientField K q).val M) := by
  rw [Polynomial.lifts_iff_coeff_lifts]
  intro i
  exact ⟨⟨q.coeff i, coeff_mem_polynomialCoefficientField K q i⟩, rfl⟩

/-- Enlarging the coefficient field preserves descent of the polynomial. -/
theorem polynomial_lifts_of_coefficientField_le (q : Polynomial M)
    (C : IntermediateField K M) (hC : (polynomialCoefficientField K q).val ≤ C) :
    q ∈ Polynomial.lifts (algebraMap C M) := by
  rw [Polynomial.lifts_iff_coeff_lifts]
  intro i
  exact ⟨⟨q.coeff i, hC (coeff_mem_polynomialCoefficientField K q i)⟩, rfl⟩

/-- In an algebraic base extension, all coefficients of a minimal polynomial
already descend to a finite intermediate field. -/
theorem exists_finiteIntermediateField_minpoly_lifts {N : Type*} [Field N] [Algebra M N] (x : N) :
    ∃ C : FiniteIntermediateField K M, minpoly M x ∈ Polynomial.lifts (algebraMap C.val M) :=
  ⟨polynomialCoefficientField K (minpoly M x), polynomial_lifts_coefficientField K _⟩

/-- The minimal polynomial descends as a monic polynomial
with the same degree and the root, over a finite coefficient field. -/
theorem exists_finiteIntermediateField_minpoly_descent {N : Type*} [Field N] [Algebra M N]
    (x : N) (hx : IsIntegral M x) :
    ∃ (C : FiniteIntermediateField K M) (q : Polynomial C.val),
      q.map (algebraMap C.val M) = minpoly M x ∧
      q.Monic ∧ q.natDegree = (minpoly M x).natDegree ∧
      q.eval₂ ((algebraMap M N).comp (algebraMap C.val M)) x = 0 := by
  obtain ⟨C, hC⟩ := exists_finiteIntermediateField_minpoly_lifts K (M := M) x
  obtain ⟨q, hq, hdegree, hmonic⟩ :=
    Polynomial.lifts_and_natDegree_eq_and_monic hC (minpoly.monic hx)
  refine ⟨C, q, hq, hmonic, hdegree, ?_⟩
  rw [← Polynomial.eval₂_map, hq]
  exact minpoly.aeval M x

section Adjoin

variable {C : Type*} [Field C] [Algebra C M]
    {N : Type*} [Field N] [Algebra C N] [Algebra M N] [IsScalarTower C M N]

/-- Descending the minimal polynomial preserves the degree of the
simple extension, with no assumed linear-disjointness conclusion. -/
theorem finrank_adjoin_eq_of_minpoly_lifts (x : N) (hx : IsIntegral C x)
    (hq : minpoly M x ∈ Polynomial.lifts (algebraMap C M)) :
    Module.finrank C (IntermediateField.adjoin C {x}) =
      Module.finrank M (IntermediateField.adjoin M {x}) := by
  rw [IntermediateField.adjoin.finrank hx,
    IntermediateField.adjoin.finrank hx.tower_top,
    ← minpoly.map_algebraMap hx hq, Polynomial.natDegree_map]

/-- The simple coefficient-field extension is linearly disjoint from
the base once the minimal polynomial descends. -/
theorem linearDisjoint_adjoin_of_minpoly_lifts (x : N) (hx : IsIntegral C x)
    (hq : minpoly M x ∈ Polynomial.lifts (algebraMap C M)) :
    (IntermediateField.adjoin C {x}).LinearDisjoint M := by
  apply IntermediateField.LinearDisjoint.of_basis_left
    (IntermediateField.powerBasisAux hx)
  have hdegree : (minpoly C x).natDegree = (minpoly M x).natDegree := by
    rw [← minpoly.map_algebraMap hx hq, Polynomial.natDegree_map]
  have h := (linearIndependent_pow (K := M) x).comp
    (Fin.cast hdegree) (Fin.cast_injective hdegree)
  have hp := (IntermediateField.adjoin.powerBasis hx).basis_eq_pow
  dsimp only [IntermediateField.adjoin.powerBasis] at hp
  have heq : (IntermediateField.adjoin C {x}).val ∘ IntermediateField.powerBasisAux hx =
      fun i : Fin (minpoly C x).natDegree => x ^ (i : ℕ) := by
    funext i
    exact congrArg Subtype.val (hp i)
  rw [heq]
  simpa only [Function.comp_def, Fin.val_cast] using h

end Adjoin

/-- An algebraic element descends to a finite coefficient field whose
simple extension is linearly disjoint from the base. -/
theorem exists_finiteIntermediateField_adjoin_linearDisjoint {N : Type*} [Field N] [Algebra M N]
    (x : N) (hx : IsIntegral M x) :
    ∃ C : FiniteIntermediateField K M,
      IsIntegral C.val x ∧ (IntermediateField.adjoin C.val {x}).LinearDisjoint M := by
  obtain ⟨C, q, hq, hmonic, _hdegree, hroot⟩ :=
    exists_finiteIntermediateField_minpoly_descent K x hx
  refine ⟨C, ?_⟩
  have hCx : IsIntegral C.val x := ⟨q, hmonic, hroot⟩
  exact ⟨hCx, linearDisjoint_adjoin_of_minpoly_lifts x hCx
    ((Polynomial.mem_lifts _).mpr ⟨q, hq⟩)⟩

/-- Finite descent can retain any prescribed finite set of the
extension: descend the finitely many power-basis coordinates as well. -/
theorem exists_finiteIntermediateField_adjoin_linearDisjoint_containing
    {N : Type*} [Field N] [Algebra M N] (b : PowerBasis M N) (S : Finset N) :
    ∃ C : FiniteIntermediateField K M, IsIntegral C.val b.gen ∧
      minpoly M b.gen ∈ Polynomial.lifts (algebraMap C.val M) ∧
      (IntermediateField.adjoin C.val {b.gen}).LinearDisjoint M ∧
      ∀ y ∈ S, y ∈ IntermediateField.adjoin C.val {b.gen} := by
  classical
  let coeffs : Finset M := S.biUnion fun y =>
    Finset.univ.image (fun i : Fin b.dim => b.basis.repr y i)
  let F : FiniteIntermediateField K M := ⟨IntermediateField.adjoin K (coeffs : Set M),
    IntermediateField.finiteDimensional_adjoin (fun x _ => Algebra.IsIntegral.isIntegral x)⟩
  let C := FiniteIntermediateField.sup (polynomialCoefficientField K (minpoly M b.gen)) F
  have hq : minpoly M b.gen ∈ Polynomial.lifts (algebraMap C.val M) :=
    polynomial_lifts_of_coefficientField_le K _ C.val (FiniteIntermediateField.le_sup_left _ _)
  obtain ⟨q, hmap, _hdegree, hmonic⟩ :=
    Polynomial.lifts_and_natDegree_eq_and_monic hq (minpoly.monic b.isIntegral_gen)
  have hCx : IsIntegral C.val b.gen := by
    refine ⟨q, hmonic, ?_⟩
    change q.eval₂ ((algebraMap M N).comp (algebraMap C.val M)) b.gen = 0
    rw [← Polynomial.eval₂_map, hmap]
    exact minpoly.aeval M b.gen
  refine ⟨C, hCx, hq, linearDisjoint_adjoin_of_minpoly_lifts b.gen hCx hq, ?_⟩
  intro y hy
  have hc (i : Fin b.dim) : b.basis.repr y i ∈ C.val := by
    apply FiniteIntermediateField.le_sup_right (polynomialCoefficientField K (minpoly M b.gen)) F
    apply IntermediateField.subset_adjoin K (coeffs : Set M)
    exact Finset.mem_biUnion.mpr ⟨y, hy, Finset.mem_image.mpr ⟨i, Finset.mem_univ _, rfl⟩⟩
  rw [← b.basis.sum_repr y]
  apply sum_mem
  intro i _
  rw [Algebra.smul_def, b.basis_eq_pow]
  apply mul_mem
  · exact (IntermediateField.adjoin C.val {b.gen}).algebraMap_mem
      ⟨b.basis.repr y i, hc i⟩
  · exact pow_mem (IntermediateField.subset_adjoin C.val {b.gen} (Set.mem_singleton b.gen)) _

/-- Cofinal descent retains an entire prescribed finite intermediate field, by
retaining its finite basis in the descended simple field. -/
theorem exists_finiteIntermediateField_adjoin_linearDisjoint_containing_layer
    {N : Type*} [Field N] [Algebra K N] [Algebra M N] [IsScalarTower K M N]
    [Module.Finite M N] [Algebra.IsSeparable M N] (D₀ : FiniteIntermediateField K N) :
    ∃ C : FiniteIntermediateField K M,
      IsIntegral C.val (Field.powerBasisOfFiniteOfSeparable M N).gen ∧
      minpoly M (Field.powerBasisOfFiniteOfSeparable M N).gen ∈
        Polynomial.lifts (algebraMap C.val M) ∧
      (IntermediateField.adjoin C.val
        {(Field.powerBasisOfFiniteOfSeparable M N).gen}).LinearDisjoint M ∧
      D₀.val ≤ (IntermediateField.adjoin C.val
        {(Field.powerBasisOfFiniteOfSeparable M N).gen}).restrictScalars K := by
  classical
  let b := Field.powerBasisOfFiniteOfSeparable M N
  let d := Module.finBasis K D₀.val
  let S : Finset N := Finset.univ.image (fun i => (d i : N))
  obtain ⟨C, hC, hq, hld, hS⟩ :=
    exists_finiteIntermediateField_adjoin_linearDisjoint_containing K b S
  refine ⟨C, hC, hq, hld, ?_⟩
  intro y hy
  have hd (i : Fin (Module.finrank K D₀.val)) :
      (d i : N) ∈ IntermediateField.adjoin C.val {b.gen} :=
    hS _ (Finset.mem_image.mpr ⟨i, Finset.mem_univ _, rfl⟩)
  have heq := congrArg (fun z : D₀.val => (z : N)) (d.sum_repr ⟨y, hy⟩)
  change D₀.val.val (∑ i, d.repr ⟨y, hy⟩ i • d i) = y at heq
  simp only [map_sum, map_smul] at heq
  rw [← heq]
  apply sum_mem
  intro i _
  rw [Algebra.smul_def]
  exact mul_mem (((IntermediateField.adjoin C.val {b.gen}).restrictScalars K).algebraMap_mem _)
    (hd i)

open scoped TensorProduct

section Tensor

variable {C : Type*} [Field C] [Algebra C M]
    {N : Type*} [Field N] [Algebra C N] [Algebra M N] [IsScalarTower C M N]

/-- The canonical multiplication map from a descended simple field
is injective, proved from the minimal polynomial. -/
theorem injective_adjoin_tensor_lift (x : N) (hx : IsIntegral C x)
    (hq : minpoly M x ∈ Polynomial.lifts (algebraMap C M)) :
    Function.Injective
      (AlgHom.liftEquiv C M (IntermediateField.adjoin C {x}) N
        (IntermediateField.adjoin C {x}).val) := by
  let D := IntermediateField.adjoin C {x}
  let : Module.Finite C D := IntermediateField.adjoin.finiteDimensional hx
  have hld : D.LinearDisjoint M := linearDisjoint_adjoin_of_minpoly_lifts x hx hq
  have : IsDomain (D ⊗[C] M) := hld.isDomain
  have : IsDomain (M ⊗[C] D) :=
    (Algebra.TensorProduct.comm C M D).toMulEquiv.isDomain
  let : Field (M ⊗[C] D) :=
    (Algebra.TensorProduct.isField_of_isAlgebraic C M D (.inr inferInstance)).toField
  exact (AlgHom.liftEquiv C M D N D.val).toRingHom.injective

/-- A primitive power basis makes the canonical multiplication
map surjective; the primitive element is a descended coordinate. -/
theorem surjective_adjoin_tensor_lift (b : PowerBasis M N) :
    Function.Surjective
      (AlgHom.liftEquiv C M (IntermediateField.adjoin C {b.gen}) N
        (IntermediateField.adjoin C {b.gen}).val) := by
  let D := IntermediateField.adjoin C {b.gen}
  let f : M ⊗[C] D →ₐ[M] N := AlgHom.liftEquiv C M D N D.val
  have hr : (⊤ : Subalgebra M N) ≤ f.range := by
    rw [← b.adjoin_gen_eq_top]
    apply Algebra.adjoin_le
    rintro y (rfl : y = b.gen)
    refine ⟨1 ⊗ₜ[C] ⟨b.gen, IntermediateField.mem_adjoin_simple_self C b.gen⟩, ?_⟩
    change (1 : M) • b.gen = b.gen
    exact one_smul M b.gen
  intro y
  exact hr trivial

/-- The canonical tensor map is an isomorphism after descending
the minimal polynomial of the primitive element. -/
def adjoinTensorEquiv (b : PowerBasis M N) (hx : IsIntegral C b.gen)
    (hq : minpoly M b.gen ∈ Polynomial.lifts (algebraMap C M)) :
    M ⊗[C] (IntermediateField.adjoin C {b.gen}) ≃ₐ[M] N :=
  AlgEquiv.ofBijective
    (AlgHom.liftEquiv C M (IntermediateField.adjoin C {b.gen}) N
      (IntermediateField.adjoin C {b.gen}).val)
    ⟨injective_adjoin_tensor_lift b.gen hx hq, surjective_adjoin_tensor_lift b⟩

/-- This is the canonical multiplication isomorphism on elements. -/
@[simp]
theorem adjoinTensorEquiv_tmul (b : PowerBasis M N) (hx : IsIntegral C b.gen)
    (hq : minpoly M b.gen ∈ Polynomial.lifts (algebraMap C M))
    (m : M) (d : IntermediateField.adjoin C {b.gen}) :
    adjoinTensorEquiv b hx hq (m ⊗ₜ[C] d) = algebraMap M N m * (d : N) := by
  change m • (d : N) = algebraMap M N m * (d : N)
  exact Algebra.smul_def m (d : N)

/-- The descended field intersects the base in precisely the
coefficient field; no intersection certificate is assumed. -/
theorem adjoin_inf_fieldRange_eq_bot (x : N) (hx : IsIntegral C x)
    (hq : minpoly M x ∈ Polynomial.lifts (algebraMap C M)) :
    IntermediateField.adjoin C {x} ⊓ (IsScalarTower.toAlgHom C M N).fieldRange = ⊥ := by
  have hld := linearDisjoint_adjoin_of_minpoly_lifts x hx hq
  have h : (IntermediateField.adjoin C {x}).LinearDisjoint
      (IsScalarTower.toAlgHom C M N).fieldRange := by
    rw [IntermediateField.linearDisjoint_iff']
    simpa only [AlgHom.fieldRange_toSubalgebra] using hld
  exact h.inf_eq_bot

end Tensor

/-- Good finite fields are cofinal in a finite separable tower. Both
the tensor isomorphism and the intersection with the base are
conclusions constructed from finite coefficient fields. -/
theorem exists_finiteIntermediateField_tensor_descent
    {N : Type*} [Field N] [Algebra K N] [Algebra M N] [IsScalarTower K M N]
    [Module.Finite M N] [Algebra.IsSeparable M N] (D₀ : FiniteIntermediateField K N) :
    ∃ (C : FiniteIntermediateField K M) (D : IntermediateField C.val N),
      Module.Finite K (D.restrictScalars K) ∧
      D₀.val ≤ D.restrictScalars K ∧
      D.LinearDisjoint M ∧
      D ⊓ (IsScalarTower.toAlgHom C.val M N).fieldRange = ⊥ ∧
      ∃ e : M ⊗[C.val] D ≃ₐ[M] N,
        ∀ (m : M) (d : D), e (m ⊗ₜ[C.val] d) = algebraMap M N m * (d : N) := by
  let b := Field.powerBasisOfFiniteOfSeparable M N
  obtain ⟨C, hx, hq, hld, hD₀⟩ :=
    exists_finiteIntermediateField_adjoin_linearDisjoint_containing_layer K (M := M) D₀
  let D := IntermediateField.adjoin C.val {b.gen}
  let : Module.Finite C.val D := IntermediateField.adjoin.finiteDimensional hx
  have hfinite : Module.Finite K D := Module.Finite.trans C.val D
  exact ⟨C, D, hfinite, hD₀, hld, adjoin_inf_fieldRange_eq_bot b.gen hx hq,
    adjoinTensorEquiv b hx hq, adjoinTensorEquiv_tmul b hx hq⟩

end FontaineWintenberger

noncomputable section

namespace FontaineWintenberger

open scoped TensorProduct

section Rings

variable (R A B : Type*) [CommRing R] [CommRing A] [CommRing B]
    [Algebra R A] [Algebra R B] [Module.Free R B] [Module.Finite R B]

/-- The determinant norm commutes with finite free tensor base change. -/
theorem norm_tensor_includeRight (b : B) :
    Algebra.norm A (1 ⊗ₜ[R] b : A ⊗[R] B) = algebraMap R A (Algebra.norm R b) := by
  rw [Algebra.norm_apply, ← Algebra.baseChange_lmul, LinearMap.det_baseChange]
  rfl

/-- Transporting the canonical tensor multiplication map preserves precisely
the norms, rather than introducing a new norm on the finite field. -/
theorem norm_eq_of_tensorEquiv {S : Type*} [CommRing S] [Algebra A S]
    (e : A ⊗[R] B ≃ₐ[A] S) (b : B) :
    Algebra.norm A (e (1 ⊗ₜ[R] b)) = algebraMap R A (Algebra.norm R b) :=
  (Algebra.norm_eq_of_algEquiv e _).trans (norm_tensor_includeRight R A B b)

end Rings

section Fields

variable {C M N : Type*} [Field C] [Field M] [Field N]
    [Algebra C M] [Algebra C N] [Algebra M N] [IsScalarTower C M N]

/-- The descended primitive field has the relative norm
under the inclusion in the finite extension. -/
theorem norm_adjoin_of_minpoly_lifts (b : PowerBasis M N)
    (hx : IsIntegral C b.gen)
    (hq : minpoly M b.gen ∈ Polynomial.lifts (algebraMap C M))
    (d : IntermediateField.adjoin C {b.gen}) :
    Algebra.norm M (d : N) = algebraMap C M (Algebra.norm C d) := by
  let : Module.Finite C (IntermediateField.adjoin C {b.gen}) :=
    IntermediateField.adjoin.finiteDimensional hx
  have h := norm_eq_of_tensorEquiv C M (IntermediateField.adjoin C {b.gen})
    (adjoinTensorEquiv b hx hq) d
  rw [adjoinTensorEquiv_tmul, map_one, one_mul] at h
  exact h

end Fields

end FontaineWintenberger

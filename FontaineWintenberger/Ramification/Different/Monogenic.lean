/-!
# The different of a monogenic extension

## The different for monogenic integer rings

Integral generation supplies fraction-field generation, so the canonical
conductor--different identity has unit conductor. No field-generation
certificate is assumed.

## The different and intrinsic ramification orders

Ideal multiplicity agrees with the normalized integral valuation on principal
ideals. The derivative formula for the conjugate polynomial then
computes the different as a product of displacements.

## Main results

* `adjoin_algebraMap_eq_top_of_integral_adjoin_eq_top`: A generator of the integral algebra
  generates the whole fraction field.
* `differentIdeal_eq_span_derivative_of_adjoin_eq_top`: The canonical different is generated by the
  derivative at an integral generator; its fraction-field generation is proved, not assumed.
* `extensionValuationSubring_different_uniformizer`: For every uniformizer in a residue-degree-one
  extension, its minimal-polynomial derivative generates the different ideal.
* `maximalIdeal_emultiplicity_span`: Canonical ideal multiplicity is the normalized integral
  valuation of an principal generator, including zero.
* `aeval_derivative_minpoly_eq_prod_displacements`: The minimal-polynomial derivative is the product
  of nonidentity conjugate displacements of an integral generator.
* `differentIdeal_eq_span_prod_displacements`: The different is the principal ideal of the product
  of nonidentity conjugate displacements, with no chosen different or polynomial certificate.
* `differentIdeal_order_eq_sum_ramificationOrder`: The ideal order of the different is the sum of
  the intrinsic nonidentity ramification orders.

## References

* Serre, *Local Fields*, Chapter IV (ramification groups, Herbrand functions, the different).
-/

@[expose] public section

namespace FontaineWintenberger

section FractionGenerator

variable (A B K L : Type*) [CommRing A] [CommRing B] [Field K] [Field L]
    [Algebra A B] [Algebra A K] [Algebra B L] [Algebra K L] [Algebra A L]
    [IsScalarTower A K L] [IsScalarTower A B L] [IsFractionRing B L]
    [FiniteDimensional K L]

/-- A generator of the integral algebra generates the whole fraction field. -/
theorem adjoin_algebraMap_eq_top_of_integral_adjoin_eq_top {θ : B}
    (hθ : Algebra.adjoin A {θ} = ⊤) :
    Algebra.adjoin K {algebraMap B L θ} = ⊤ := by
  let E := IntermediateField.adjoin K {algebraMap B L θ}
  have hB (b : B) : algebraMap B L b ∈ E := by
    have hle : Algebra.adjoin A {θ} ≤
        (E.toSubalgebra.restrictScalars A).comap (IsScalarTower.toAlgHom A B L) := by
      apply Algebra.adjoin_le
      intro y hy
      rcases Set.mem_singleton_iff.mp hy with rfl
      exact IntermediateField.subset_adjoin K _ (Set.mem_singleton _)
    exact hle (by rw [hθ]; trivial)
  have hE : E = ⊤ := by
    apply top_unique
    intro x _
    obtain ⟨b, c, _, rfl⟩ := IsFractionRing.div_surjective B x
    exact E.div_mem (hB b) (hB c)
  have h := congrArg IntermediateField.toSubalgebra hE
  simpa only [E, IntermediateField.adjoin_toSubalgebra, IntermediateField.top_toSubalgebra] using h

end FractionGenerator

section Different

variable (A B K L : Type*) [CommRing A] [IsDomain A] [IsIntegrallyClosed A]
    [CommRing B] [IsDedekindDomain B]
    [Field K] [Field L] [Algebra A B] [Algebra A K] [IsFractionRing A K]
    [Algebra B L] [IsFractionRing B L] [Algebra K L] [Algebra A L]
    [IsScalarTower A K L] [IsScalarTower A B L]
    [FiniteDimensional K L] [Algebra.IsSeparable K L] [IsIntegralClosure B A L]
    [Module.IsTorsionFree A B]

include K L in
/-- The canonical different is generated by the derivative at an integral
generator; its fraction-field generation is proved, not assumed. -/
theorem differentIdeal_eq_span_derivative_of_adjoin_eq_top {θ : B}
    (hθ : Algebra.adjoin A {θ} = ⊤) :
    differentIdeal A B = Ideal.span {Polynomial.aeval θ (minpoly A θ).derivative} := by
  have hfield := adjoin_algebraMap_eq_top_of_integral_adjoin_eq_top A B K L hθ
  have h := conductor_mul_differentIdeal A K L θ hfield
  simpa only [conductor_eq_top_of_adjoin_eq_top hθ, ← Ideal.one_eq_top, one_mul] using h

end Different

section ChosenExtension

variable (K : Type*) [NontriviallyNormedField K] [IsCompleteDiscreteValuedField K]

variable (L : Type*) [Field L] [Algebra K L] [FiniteDimensional K L]
    [Algebra.IsSeparable K L]
variable {Γ : Type*} [LinearOrderedCommGroupWithZero Γ] (w : Valuation L Γ)
    [(NormedField.valuation (K := K)).HasExtension w]

local notation "OL" => Valuation.valuationSubring w

/-- For every uniformizer in a residue-degree-one extension, its
minimal-polynomial derivative generates the different ideal. -/
theorem extensionValuationSubring_different_uniformizer
    (hf : Module.finrank (IsLocalRing.ResidueField 𝒪[K]) (IsLocalRing.ResidueField OL) = 1)
    {π : OL} (hπ : Irreducible π) :
    letI := extensionValuationSubring_isDiscreteValuationRing K L w
    differentIdeal 𝒪[K] OL = Ideal.span {Polynomial.aeval π (minpoly 𝒪[K] π).derivative} := by
  have := extensionValuationSubring_isDiscreteValuationRing K L w
  have hdegree := extensionValuationSubring_ramificationIdx_mul_residueDegree K L w
  rw [hf, mul_one] at hdegree
  exact differentIdeal_eq_span_derivative_of_adjoin_eq_top 𝒪[K] OL K L
    (extensionValuationSubring_adjoin_uniformizer_eq_top K L w hdegree hπ)

end ChosenExtension

end FontaineWintenberger

namespace FontaineWintenberger

open IsDiscreteValuationRing Polynomial

/-- Canonical ideal multiplicity is the normalized integral valuation of an
principal generator, including zero. -/
theorem maximalIdeal_emultiplicity_span {B : Type*} [CommRing B] [IsDomain B]
    [IsDiscreteValuationRing B] (x : B) :
    emultiplicity (IsLocalRing.maximalIdeal B) (Ideal.span {x}) = addVal B x := by
  apply ENat.eq_of_forall_natCast_le_iff
  intro n
  rw [← pow_dvd_iff_le_emultiplicity, Ideal.dvd_iff_le,
    Ideal.span_singleton_le_iff_mem, mem_maximalIdeal_pow_iff_addVal]

section Conjugates

variable {A B : Type*} [CommRing A] [IsDomain A] [IsIntegrallyClosed A]
    [CommRing B] [IsDomain B] [Algebra A B] [FaithfulSMul A B]
variable (G : Type*) [Group G] [Fintype G] [DecidableEq G]
    [MulSemiringAction G B] [IsGaloisGroup G A B]

/-- The minimal-polynomial derivative is the product of nonidentity
conjugate displacements of an integral generator. -/
theorem aeval_derivative_minpoly_eq_prod_displacements {θ : B}
    (hθ : Algebra.adjoin A {θ} = ⊤) :
    Polynomial.aeval θ (minpoly A θ).derivative =
      ∏ g ∈ Finset.univ.erase (1 : G), (θ - g • θ) := by
  classical
  let Q : Polynomial B := ∏ g ∈ Finset.univ.erase (1 : G), (X - C (g • θ))
  have hprod : (∏ g : G, (X - C (g • θ))) = (X - C θ) * Q := by
    rw [← Finset.mul_prod_erase Finset.univ _ (Finset.mem_univ (1 : G)), one_smul]
  have h := congrArg (fun f : Polynomial B => f.derivative.eval θ)
    (map_minpoly_eq_prod_conjugates G hθ)
  rw [hprod] at h
  simpa [derivative_map, Q, eval_prod] using h

end Conjugates

section Different

variable (A B K L : Type*) [CommRing A] [IsDomain A] [IsIntegrallyClosed A]
    [CommRing B] [IsDomain B] [IsDiscreteValuationRing B]
    [Field K] [Field L] [Algebra A B] [FaithfulSMul A B]
    [Algebra A K] [IsFractionRing A K] [Algebra B L] [IsFractionRing B L]
    [Algebra K L] [Algebra A L] [IsScalarTower A K L] [IsScalarTower A B L]
    [FiniteDimensional K L] [Algebra.IsSeparable K L] [IsIntegralClosure B A L]
variable (G : Type*) [Group G] [Fintype G] [DecidableEq G]
    [MulSemiringAction G B] [IsGaloisGroup G A B]

include K L in
/-- The different is the principal ideal of the product of nonidentity
conjugate displacements, with no chosen different or polynomial certificate. -/
theorem differentIdeal_eq_span_prod_displacements {θ : B}
    (hθ : Algebra.adjoin A {θ} = ⊤) :
    differentIdeal A B =
      Ideal.span {∏ g ∈ Finset.univ.erase (1 : G), (θ - g • θ)} := by
  rw [differentIdeal_eq_span_derivative_of_adjoin_eq_top A B K L hθ,
    aeval_derivative_minpoly_eq_prod_displacements G hθ]

include K L in
/-- The ideal order of the different is the sum of the intrinsic
nonidentity ramification orders. -/
theorem differentIdeal_order_eq_sum_ramificationOrder [SMulCommClass G A B] {θ : B}
    (hθ : Algebra.adjoin A {θ} = ⊤) :
    emultiplicity (IsLocalRing.maximalIdeal B) (differentIdeal A B) =
      ∑ g ∈ Finset.univ.erase (1 : G), ramificationOrder (R := B) G g := by
  rw [differentIdeal_eq_span_prod_displacements A B K L G hθ, maximalIdeal_emultiplicity_span]
  have hprod (s : Finset G) :
      addVal B (∏ g ∈ s, (θ - g • θ)) = ∑ g ∈ s, addVal B (θ - g • θ) := by
    classical
    induction s using Finset.induction_on with
    | empty => simp
    | @insert g s hg ih => simp only [Finset.prod_insert hg, Finset.sum_insert hg, addVal_mul, ih]
  rw [hprod]
  apply Finset.sum_congr rfl
  intro g _
  rw [ramificationOrder_eq_generator G hθ, ← neg_sub (g • θ) θ, AddValuation.map_neg]

end Different

end FontaineWintenberger

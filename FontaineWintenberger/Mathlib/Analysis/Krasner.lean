module

public import Mathlib.Analysis.Normed.Field.Krasner
public import Mathlib.FieldTheory.SeparableClosure

/-!
# Krasner descent and uniqueness of the nearby conjugate

Completeness of the base supplies the existing Krasner theorem.
Ultrametric separation identifies the unique nearby image in a simple field.

## Main results

* `krasner_mem_adjoin`: The complete base, rather than an assumed Krasner certificate, gives descent
  to the simple field generated by the nearby element.
* `isConjRoot_adjoin_simple_gen_image`: An image of the simple-field generator is an conjugate, by
  the two minimal-polynomial embedding identities.
* `conjugate_eq_of_norm_sub_lt`: Two elements closer to the same point than the distance separating
  distinct conjugates must be the conjugate.
* `nearby_simple_embedding_unique`: The inclusion is the unique nearby embedding of the simple
  intermediate field.
* `krasner_mem_adjoin_and_unique`: Actual Krasner descent and uniqueness use the nearby element and
  the simple-field inclusion.

## References

* Mathlib; this file is an upstream candidate and has no project-specific reference.
-/

@[expose] public section

noncomputable section

namespace FontaineWintenberger

open IntermediateField

section CompleteBase

variable {K Ω : Type*} [NontriviallyNormedField K] [IsUltrametricDist K]
    [CompleteSpace K] [NormedField Ω] [NormedAlgebra K Ω]
    [Algebra.IsSeparable K Ω] [Normal K Ω]

/-- The complete base, rather than an assumed Krasner certificate,
gives descent to the simple field generated by the nearby element. -/
theorem krasner_mem_adjoin {a b : Ω}
    (hclose : ∀ a' : Ω, IsConjRoot K a a' → a ≠ a' →
      ‖a - b‖ < ‖a - a'‖) : a ∈ K⟮b⟯ := by
  exact IsKrasner.krasner (Algebra.IsSeparable.isSeparable K a)
    (Normal.splits inferInstance a) (Algebra.IsIntegral.isIntegral b) hclose

end CompleteBase

section Uniqueness

variable {K Ω : Type*} [Field K] [NormedField Ω] [IsUltrametricDist Ω] [Algebra K Ω]

omit [IsUltrametricDist Ω] in
/-- An image of the simple-field generator is an
conjugate, by the two minimal-polynomial embedding identities. -/
theorem isConjRoot_adjoin_simple_gen_image (a : Ω) (f : K⟮a⟯ →ₐ[K] Ω) :
    IsConjRoot K a (f (AdjoinSimple.gen K a)) := by
  exact (minpoly.algHom_eq (K⟮a⟯).val (K⟮a⟯).val.injective (AdjoinSimple.gen K a)).trans
    (minpoly.algHom_eq f f.injective (AdjoinSimple.gen K a)).symm

/-- Two elements closer to the same point than the distance separating
distinct conjugates must be the conjugate. -/
theorem conjugate_eq_of_norm_sub_lt {a a' b : Ω} {δ : ℝ}
    (hsep : ∀ c : Ω, IsConjRoot K a c → a ≠ c → δ ≤ ‖a - c‖)
    (ha : ‖a - b‖ < δ) (ha' : ‖a' - b‖ < δ) (hc : IsConjRoot K a a') : a' = a := by
  by_contra hne
  have hbound : ‖a - a'‖ < δ := by
    calc
      _ = ‖(a - b) - (a' - b)‖ := by congr 1; ring
      _ ≤ max ‖a - b‖ ‖a' - b‖ := by
        simpa only [sub_eq_add_neg, norm_neg] using
          IsUltrametricDist.norm_add_le_max (a - b) (-(a' - b))
      _ < δ := max_lt ha ha'
  exact (not_lt_of_ge (hsep a' hc (Ne.symm hne))) hbound

/-- The inclusion is the unique nearby embedding of the
simple intermediate field. -/
theorem nearby_simple_embedding_unique {a b : Ω} {δ : ℝ}
    (hsep : ∀ c : Ω, IsConjRoot K a c → a ≠ c → δ ≤ ‖a - c‖)
    (ha : ‖a - b‖ < δ) (f : K⟮a⟯ →ₐ[K] Ω)
    (hf : ‖f (AdjoinSimple.gen K a) - b‖ < δ) : f = (K⟮a⟯).val := by
  apply IntermediateField.adjoin_algHom_ext K
  intro x hx
  have hx' : x = a := Set.mem_singleton_iff.mp hx
  subst x
  exact conjugate_eq_of_norm_sub_lt hsep ha hf (isConjRoot_adjoin_simple_gen_image a f)

end Uniqueness

section DescentAndUniqueness

variable {K Ω : Type*} [NontriviallyNormedField K] [IsUltrametricDist K]
    [CompleteSpace K] [NormedField Ω] [NormedAlgebra K Ω]
    [Algebra.IsSeparable K Ω] [Normal K Ω]

/-- Actual Krasner descent and uniqueness use the nearby
element and the simple-field inclusion. -/
theorem krasner_mem_adjoin_and_unique {a b : Ω} {δ : ℝ}
    (hsep : ∀ c : Ω, IsConjRoot K a c → a ≠ c → δ ≤ ‖a - c‖)
    (ha : ‖a - b‖ < δ) :
    a ∈ K⟮b⟯ ∧ ∀ f : K⟮a⟯ →ₐ[K] Ω,
      ‖f (AdjoinSimple.gen K a) - b‖ < δ → f = (K⟮a⟯).val := by
  let : IsUltrametricDist Ω := IsUltrametricDist.of_normedAlgebra K
  exact ⟨krasner_mem_adjoin (fun c hc hne => ha.trans_le (hsep c hc hne)),
    fun f hf => nearby_simple_embedding_unique hsep ha f hf⟩

end DescentAndUniqueness

end FontaineWintenberger

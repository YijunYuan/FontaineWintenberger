module

public import Mathlib.FieldTheory.AbsoluteGaloisGroup
public import Mathlib.FieldTheory.Galois.Profinite
public import Mathlib.FieldTheory.PurelyInseparable.Basic
public import Mathlib.Algebra.CharP.Reduced
public import Mathlib.Topology.Algebra.Group.Neighborhood

/-!
# The absolute Galois group and the separable closure

Restriction from an algebraic closure to the separable closure identifies
`Field.absoluteGaloisGroup K = Gal(K^al/K)` with `Gal(K^sep/K)` as topological groups: the
restriction is a continuous surjective homomorphism (Mathlib), it is injective because `K^al/K^sep`
is purely inseparable, and it is open because every finite subextension of `K^al/K` is generated by
`q`-power roots of a finite subextension of `K^sep/K`. In particular the absolute Galois group is
compact even when `K` is imperfect (where `K^al/K` is not Galois).

## Main declarations

* `Field.absoluteGaloisGroup.restrictSep`: the restriction homomorphism.
* `Field.absoluteGaloisGroup.sepEquiv : absoluteGaloisGroup K ≃ₜ* Gal(SeparableClosure K/K)`.
* `instance : CompactSpace (absoluteGaloisGroup K)`.
-/

@[expose] public section

noncomputable section

namespace Field.absoluteGaloisGroup

open IntermediateField Topology

variable (K : Type*) [Field K]

local notation "G_K" => absoluteGaloisGroup K

/-- An element of the absolute Galois group, as an automorphism of the algebraic closure. -/
abbrev toAlgEquiv (σ : G_K) : AlgebraicClosure K ≃ₐ[K] AlgebraicClosure K := σ

/-- Restriction of an automorphism of the algebraic closure to the separable closure. -/
def restrictSep : G_K →* Gal(SeparableClosure K/K) :=
  AlgEquiv.restrictNormalHom (F := K) (K₁ := AlgebraicClosure K) (SeparableClosure K)

@[simp]
theorem restrictSep_apply (σ : G_K) (x : SeparableClosure K) :
    (restrictSep K σ x : AlgebraicClosure K) = toAlgEquiv K σ x :=
  AlgEquiv.restrictNormal_commutes (toAlgEquiv K σ) (SeparableClosure K) x

theorem restrictSep_surjective : Function.Surjective (restrictSep K) :=
  AlgEquiv.restrictNormalHom_surjective (AlgebraicClosure K)

theorem restrictSep_injective : Function.Injective (restrictSep K) := by
  intro σ τ h
  have hr := IsPurelyInseparable.injective_comp_algebraMap (SeparableClosure K)
    (AlgebraicClosure K) (AlgebraicClosure K)
    (a₁ := (toAlgEquiv K σ : AlgebraicClosure K ≃+* AlgebraicClosure K).toRingHom)
    (a₂ := (toAlgEquiv K τ : AlgebraicClosure K ≃+* AlgebraicClosure K).toRingHom) (by
      ext x
      have := congrArg (fun ρ : Gal(SeparableClosure K/K) => (ρ x : AlgebraicClosure K)) h
      simpa using this)
  exact AlgEquiv.ext fun x => RingHom.congr_fun hr x

theorem continuous_restrictSep : Continuous (restrictSep K) :=
  InfiniteGalois.restrictNormalHom_continuous (k := K) (K := AlgebraicClosure K)
    (separableClosure K (AlgebraicClosure K))

/-- A finite subextension of `K^al/K` is fixed by every automorphism fixing a suitable finite
subextension of `K^sep/K`: raise the generators to a `q`-power lying in `K^sep`. -/
theorem exists_fixingSubgroup_le_map (E : IntermediateField K (AlgebraicClosure K))
    [FiniteDimensional K E] :
    ∃ E' : IntermediateField K (SeparableClosure K), FiniteDimensional K E' ∧
      ∀ τ : Gal(SeparableClosure K/K), τ ∈ E'.fixingSubgroup →
        ∃ σ : G_K, σ ∈ E.fixingSubgroup ∧ restrictSep K σ = τ := by
  classical
  obtain ⟨s, hs_fin, rfl⟩ := fg_def.mp (fg_of_fg_toSubalgebra E
    ((Subalgebra.fg_top E.toSubalgebra).mp (Subalgebra.fg_of_submodule_fg
      (Module.Finite.fg_top (R := K) (M := E)))))
  let q := ringExpChar K
  have : ExpChar (AlgebraicClosure K) q :=
    expChar_of_injective_algebraMap (algebraMap K (AlgebraicClosure K)).injective q
  have hpow : ∀ x : AlgebraicClosure K,
      ∃ n : ℕ, x ^ q ^ n ∈ separableClosure K (AlgebraicClosure K) := fun x => by
    obtain ⟨n, y, hy⟩ := IsPurelyInseparable.pow_mem (SeparableClosure K) q x
    exact ⟨n, hy ▸ y.property⟩
  choose n hn using hpow
  let t : Set (SeparableClosure K) :=
    Set.range fun x : s => (⟨(x : AlgebraicClosure K) ^ q ^ n x, hn x⟩ : SeparableClosure K)
  have ht : t.Finite := by
    have := hs_fin.to_subtype
    exact Set.finite_range _
  refine ⟨adjoin K t, ?_, fun τ hτ => ?_⟩
  · have := ht.to_subtype
    exact finiteDimensional_adjoin fun x _ => Algebra.IsIntegral.isIntegral x
  obtain ⟨σ, hσ⟩ := restrictSep_surjective K τ
  refine ⟨σ, ?_, hσ⟩
  change toAlgEquiv K σ ∈ (adjoin K s).fixingSubgroup
  rw [IntermediateField.mem_fixingSubgroup_iff]
  intro x hx
  suffices h : adjoin K s ≤ fixedField (Subgroup.zpowers (toAlgEquiv K σ)) by
    exact (mem_fixedField_iff _ _).mp (h hx) _ (Subgroup.mem_zpowers _)
  refine adjoin_le_iff.mpr fun y hy => ?_
  rw [SetLike.mem_coe, mem_fixedField_iff]
  -- `σ` fixes `y ^ q ^ n` since it lies in `K^sep` and `τ` fixes `t`
  have hfix : toAlgEquiv K σ (y ^ q ^ n y) = y ^ q ^ n y := by
    have hmem : (⟨y ^ q ^ n y, hn y⟩ : SeparableClosure K) ∈ adjoin K t :=
      subset_adjoin K t ⟨⟨y, hy⟩, rfl⟩
    have := (IntermediateField.mem_fixingSubgroup_iff _ τ).mp hτ _ hmem
    rw [← hσ] at this
    simpa using congrArg (fun z : SeparableClosure K => (z : AlgebraicClosure K)) this
  have h : toAlgEquiv K σ y = y := by
    apply iterateFrobenius_inj (AlgebraicClosure K) q (n y)
    simpa only [iterateFrobenius_def, map_pow] using hfix
  rintro _ ⟨k, rfl⟩
  change (toAlgEquiv K σ ^ k) y = y
  induction k using Int.induction_on with
  | zero => simp
  | succ k ih => rw [zpow_add_one, AlgEquiv.mul_apply, h, ih]
  | pred k ih =>
      have hinv : (toAlgEquiv K σ)⁻¹ y = y :=
        (toAlgEquiv K σ).injective
          (by rw [← AlgEquiv.mul_apply, mul_inv_cancel, AlgEquiv.one_apply, h])
      rw [zpow_sub_one, AlgEquiv.mul_apply, hinv, ih]

theorem isOpenMap_restrictSep : IsOpenMap (restrictSep K) := by
  refine IsTopologicalGroup.isOpenMap_iff_nhds_one.mpr ?_
  intro U hU
  rw [Filter.mem_map] at hU
  obtain ⟨E, hE, hEU⟩ := (krullTopology_mem_nhds_one_iff K (AlgebraicClosure K) _).mp hU
  rw [krullTopology_mem_nhds_one_iff]
  obtain ⟨E', hE', h⟩ := exists_fixingSubgroup_le_map K E
  refine ⟨E', hE', fun τ hτ => ?_⟩
  obtain ⟨σ, hσE, rfl⟩ := h τ hτ
  exact hEU hσE

/-- `Gal(K^al/K) ≃ Gal(K^sep/K)` as topological groups, by restriction. -/
def sepEquiv : G_K ≃ₜ* Gal(SeparableClosure K/K) :=
  { MulEquiv.ofBijective (restrictSep K) ⟨restrictSep_injective K, restrictSep_surjective K⟩,
    (Equiv.ofBijective (restrictSep K)
      ⟨restrictSep_injective K, restrictSep_surjective K⟩).toHomeomorphOfContinuousOpen
      (continuous_restrictSep K) (isOpenMap_restrictSep K) with }

@[simp]
theorem sepEquiv_apply (σ : G_K) : sepEquiv K σ = restrictSep K σ := rfl

instance : CompactSpace G_K := (sepEquiv K).symm.toHomeomorph.compactSpace

end Field.absoluteGaloisGroup
